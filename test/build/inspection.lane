module Test.Build.Inspection

import Basic.Build.Inspection.{ SourceInspection, decode as decode_inspection }
import Basic.Data.Option.{ Option }
import Basic.Data.String.{ string_impl_equal }
import Basic.Debug.String.{ string_impl_debug }
import Test.Assert.{ Assert, assert_equal, assert_true }

pub fn test_inspection() -> Unit ! Assert {
  offer source_info : String = "test_build_inspection"
  let decoded =
    decode_inspection(
      " { \"imports\" : [\"Basic.A\", \"Basic.B\"], \"module\" : \"App.Main\", \"schema\" : 1 }\n"
    )
  match decoded {
    none() => assert_true(false)
    some(SourceInspection::{ module_name, imports }) => {
      assert_equal(module_name, "App.Main")
      match imports {
        cons(first, cons(second, empty())) => {
          assert_equal(first, "Basic.A")
          assert_equal(second, "Basic.B")
        }
        _ => assert_true(false)
      }
    }
  }
  assert_true(
    match decode_inspection("{\"schema\":2,\"module\":\"App.Main\",\"imports\":[]}") {
      none() => true
      some(_) => false
    }
  )
  assert_true(
    match
      decode_inspection(
        "{\"schema\":1,\"module\":\"App.Main\",\"module\":\"Other\",\"imports\":[]}"
      ) {
      none() => true
      some(_) => false
    }
  )
}
