module Test.Data.I32

import Basic.Data.I32.*
import Basic.Data.I64 as I64
import Basic.Trait.Num.{ Add, Sub, Mul, Div, Rem, Neg }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ Compare }
import Basic.Summon.{ summon }
import Basic.Ops.{ op_add, op_sub, op_mul, op_div, op_rem, op_neg, op_less }
import Test.Assert.{ Assert }

pub fn test_i32() -> Unit ! Assert {
  // Addition, subtraction, multiplication, and negation wrap modulo 2^32.
  assert_eq!(to_i64(maximum + from_i64(1)), to_i64(minimum), I64.i64_impl_equal)
  assert_eq!(to_i64(minimum - from_i64(1)), to_i64(maximum), I64.i64_impl_equal)
  assert_eq!(to_i64(from_i64(65536) * from_i64(65536)), 0, I64.i64_impl_equal)
  assert_eq!(to_i64(-minimum), to_i64(minimum), I64.i64_impl_equal)
  // Division truncates toward zero.
  assert_eq!(to_i64(from_i64(-7) / from_i64(3)), -2, I64.i64_impl_equal)
  // Remainder takes the sign of the dividend and yields zero for -2^31 % -1.
  assert_eq!(to_i64(from_i64(-7) % from_i64(3)), -1, I64.i64_impl_equal)
  assert_eq!(to_i64(minimum % from_i64(-1)), 0, I64.i64_impl_equal)
  // from_i64 keeps the low 32 bits and interprets them as signed two's complement.
  assert_eq!(to_i64(from_i64(2147483648)), to_i64(minimum), I64.i64_impl_equal)
  // Equality and ordering interpret operands as signed values.
  assert_eq!(from_i64(42), from_i64(42), summon())
  assert_true!(from_i64(-1) < from_i64(0))
}
