module Test.Data.I32

import Basic.Data.I32.*
import Basic.Trait.Num.{ Add, Sub, Mul, Div, Rem, Neg }
import Basic.Conv.I64.{ i64_to_i32 }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ Compare }
import Basic.Summon.{ summon }
import Basic.Ops.{ op_add, op_sub, op_mul, op_div, op_rem, op_neg, op_less }
import Test.Assert.{ Assert }

pub fn test_i32() -> Unit ! Assert {
  assert_eq!(maximum + i64_to_i32(1), minimum, summon())
  assert_eq!(minimum - i64_to_i32(1), maximum, summon())
  assert_eq!(i64_to_i32(65536) * i64_to_i32(65536), i64_to_i32(0), summon())
  assert_eq!(-minimum, minimum, summon())
  assert_eq!(i64_to_i32(-7) / i64_to_i32(3), i64_to_i32(-2), summon())
  assert_eq!(i64_to_i32(-7) % i64_to_i32(3), i64_to_i32(-1), summon())
  assert_eq!(minimum % i64_to_i32(-1), i64_to_i32(0), summon())
  assert_eq!(i64_to_i32(2147483648), minimum, summon())
  assert_eq!(i64_to_i32(42), i64_to_i32(42), summon())
  assert_true!(i64_to_i32(-1) < i64_to_i32(0))
}
