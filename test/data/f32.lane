module Test.Data.F32

import Basic.Data.F32.*
import Basic.Data.I64.{ i64_impl_equal }
import Basic.Trait.Num.{ Add, Sub, Mul, Div, Neg }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ Compare }
import Basic.Summon.{ summon }
import Basic.Ops.{ op_add, op_sub, op_mul, op_div, op_neg, op_less }
import Test.Assert.{ Assert }

pub fn test_f32() -> Unit ! Assert {
  let one = from_i64(1)
  let two = from_i64(2)
  let three = from_i64(3)
  assert_eq!(one + two, three, summon())
  assert_eq!(three - one, two, summon())
  assert_eq!(one * two, two, summon())
  assert_eq!(two / two, one, summon())
  assert_eq!(-(-one), one, summon())
  assert_true!(ninf < inf)
  // NaN is unordered and compares unequal to itself.
  assert_not_eq!(nan, nan, summon())
  assert_eq!(to_i64(from_i64(42)), 42, summon())
  // Widening to F64 and narrowing back is exact for values F32 can hold.
  assert_eq!(from_f64(to_f64(from_i64(42))), from_i64(42), summon())
}
