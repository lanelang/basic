module Test.Data.F32

import Basic.Debug.F32.{ f32_impl_debug }
import Basic.Data.F32.*
import Basic.Trait.Num.{ Add, Sub, Mul, Div, Neg }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ PartialCompare, partial_compare, compare }
import Basic.Ops.{ op_add, op_sub, op_mul, op_div, op_neg, op_less }
import Test.Assert.{ Assert, assert_equal, assert_true, assert_not_equal }

pub fn test_f32() -> Unit ! { Assert, Panic } {
  offer source_info : String = "test_f32"
  assert_true(
    match to_i64(nan) {
      none() => true
      _ => false
    }
  )
  assert_true(
    match to_i64(inf) {
      none() => true
      _ => false
    }
  )
  assert_true(
    match to_i64(ninf) {
      none() => true
      _ => false
    }
  )
  assert_true(
    match to_i64(from_i64(9223372036854775807)) {
      none() => true
      _ => false
    }
  )
  assert_true(
    match to_i64(from_i64(-9223372036854775808)) {
      some(-9223372036854775808) => true
      _ => false
    }
  )
  assert_true(
    match partial_compare(nan, nan) {
      none() => true
      _ => false
    }
  )
  assert_true(
    match compare(nan, nan) {
      equal() => true
      _ => false
    }
  )
  assert_true(
    match compare(inf, nan) {
      less() => true
      _ => false
    }
  )
  assert_true(
    match compare(nan, ninf) {
      greater() => true
      _ => false
    }
  )
  assert_true(
    match compare(0.0f32, -0.0f32) {
      equal() => true
      _ => false
    }
  )
  let one = from_i64(1)
  let two = from_i64(2)
  let three = from_i64(3)
  assert_equal(one + two, three)
  assert_equal(three - one, two)
  assert_equal(one * two, two)
  assert_equal(two / two, one)
  assert_equal(-(-one), one)
  assert_true(ninf < inf)
  // NaN is unordered and compares unequal to itself.
  assert_not_equal(nan, nan)
  assert_true(
    match to_i64(from_i64(42)) {
      some(42) => true
      _ => false
    }
  )
  // Widening to F64 and narrowing back is exact for values F32 can hold.
  assert_equal(from_f64(to_f64(from_i64(42))), from_i64(42))
}
