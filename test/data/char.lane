module Test.Data.Char

import Basic.Data.Char.*
import Basic.Data.Option.{ Option, option_impl_equal }
import Basic.Data.String.{ string_impl_equal }
import Basic.Data.I64.{ i64_impl_equal }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ Compare }
import Basic.Summon.{ summon, summon_via }
import Basic.Ops.{ op_less }
import Test.Assert.{ Assert }

pub fn test_char() -> Unit ! Assert {
  // Scalar construction accepts the whole Unicode scalar range.
  assert_eq!(from_i64(0), some('\0'), summon_via())
  assert_eq!(from_i64(233), some('é'), summon_via())
  assert_eq!(from_i64(20320), some('你'), summon_via())
  assert_eq!(from_i64(128512), some('😀'), summon_via())
  // Negative values, surrogates, and out-of-range values are rejected.
  assert_eq![Option[Char]](from_i64(-1), none(), summon_via())
  assert_eq![Option[Char]](from_i64(55296), none(), summon_via())
  assert_eq![Option[Char]](from_i64(1114112), none(), summon_via())
  assert_eq!(to_i64('😀'), 128512, summon())
  // UTF-8 encoding covers all four widths.
  assert_eq!(to_string('A'), "A", summon())
  assert_eq!(to_string('é'), "é", summon())
  assert_eq!(to_string('你'), "你", summon())
  assert_eq!(to_string('😀'), "😀", summon())
  assert_true!('你' < '😀')
}
