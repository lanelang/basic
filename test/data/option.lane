module Test.Data.Option

import Basic.Data.Option.*
import Basic.Trait.Ops.{ int_equal_ops, unit_equal_ops, Equal }
import Basic.Summon.{ summon_via }
import Test.Assert.{ Assert }

pub fn test_equal() -> Unit ! Assert {
  assert_eq!(some(1), some(1), summon_via())
  assert_eq![Option[Int]](none(), none(), summon_via())
  assert_eq![Option[Unit]](none(), none(), summon_via())
  assert_not_eq![Option[Int]](some(1), none(), summon_via())
  assert_not_eq![Option[Int]](some(1), some(2), summon_via())
}
