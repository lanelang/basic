module Test.Data.Result

import Basic.Prelude.*
import Basic.Data.Result as R
import Basic.Data.Option as O
import Basic.Debug.Result.{ result_impl_debug }
import Basic.Debug.Tuple.{ tuple_impl_debug }
import Basic.Debug.Option.{ option_impl_debug }
import Basic.Data.Tuple.{ tuple_impl_equal }
import Test.Assert.{ Assert, assert_equal, assert_true }

pub fn test_result() -> Unit ! Assert {
  offer source_info : String = "result and option contracts"
  let equality = R.result_impl_equal[I64, String]()
  assert_true(equality.equal(Result[I64, String]::ok(1), Result[I64, String]::ok(1)))
  assert_true(!equality.equal(Result[I64, String]::ok(1), Result[I64, String]::err("1")))
  assert_true(!equality.equal(Result[I64, String]::err("a"), Result[I64, String]::err("b")))
  assert_equal(
    debug(Result[I64, String]::err("bad"), debug_impl=result_impl_debug()),
    "err(\"bad\")"
  )
  assert_equal(debug((1, "x"), debug_impl=tuple_impl_debug()), "(1, \"x\")")
  assert_equal(debug(Option[I64]::some(1), debug_impl=option_impl_debug()), "some(1)")
  let pair_equality = tuple_impl_equal[I64, String]()
  assert_true(pair_equality.equal((1, "x"), (1, "x")))
  assert_true(!pair_equality.equal((1, "x"), (1, "y")))
  let success : Result[I64, String] = ok(7)
  let failure : Result[I64, String] = err("first")
  assert_equal(
    R.get_or_else(
      success,
      fn(_error) {
        assert_true(false)
        0
      }
    ),
    7
  )
  assert_equal(
    R.get_or_else(
      failure,
      fn(error) {
        assert_equal(error, "first")
        42
      }
    ),
    42
  )
  assert_true(
    match
      R.flat_map[I64, I64, String, Assert](
        failure,
        fn(_value) {
          assert_true(false)
          Result[I64, String]::ok(0)
        }
      ) {
      err("first") => true
      _ => false
    }
  )
  assert_true(
    match
      R.map_err[I64, String, I64, Assert](
        failure,
        fn(error) {
          assert_equal(error, "first")
          9
        }
      ) {
      err(9) => true
      _ => false
    }
  )
  let function : Result[(I64) -> I64, String] = err("second")
  assert_true(
    match R.apply(failure, function) {
      err("first") => true
      _ => false
    }
  )
  let provider = R.result_impl_flat_mappable[String]()
  assert_true(
    match
      provider.flat_map[I64, I64, Assert](
        success,
        fn(value) {
          assert_equal(value, 7)
          Result[I64, String]::ok(8)
        }
      ) {
      ok(8) => true
      _ => false
    }
  )
  assert_equal(
    O.get_or_else(
      Option::some(3),
      fn() {
        assert_true(false)
        0
      }
    ),
    3
  )
  assert_equal(
    O.get_or_else(
      Option[I64]::none(),
      fn() {
        assert_true(true)
        4
      }
    ),
    4
  )
  assert_true(
    O.is_some(
      O.or_else(
        Option[I64]::none(),
        fn() {
          Option::some(5)
        }
      )
    )
  )
  assert_true(R.is_ok(success))
  assert_true(R.is_err(failure))
}
