module Test.Data.String

import Basic.Data.String.*
import Basic.Conv.Char.{ char_impl_debug }
import Basic.Conv.I64.{ i64_impl_debug }
import Basic.Data.Char.{ char_impl_equal, to_string }
import Basic.Data.I64.{ i64_impl_equal }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ Compare }
import Basic.Ops.{ op_less }
import Test.Eff.Bound.{ expect_in_bounds, is_out_of_bounds }
import Test.Assert.{ Assert, assert_equal, assert_true, assert_false }

pub fn test_string() -> Unit ! Assert {
  offer source_info : String = "test_string"
  let text = "Aé中😀\0"
  // Byte length is the UTF-8 size; scalar count is independent of it.
  assert_equal(byte_length(text), 11)
  assert_equal(scalar_count(text), 5)
  assert_true(is_empty(""))
  assert_false(is_empty(text))
  assert_equal(from_char('中'), "中")
  assert_equal(concat("中", "😀"), "中😀")
  // Ordering compares scalar values, so a prefix sorts first.
  assert_true("a" < "aa")
  assert_true("中" < "😀")
  assert_false("😀" < "中")
  let monoid = string_impl_monoid
  assert_equal(monoid.semigroup_impl.append("中", "😀"), "中😀")
  assert_equal(monoid.empty, "")
  // Positions are scalar indices, not byte offsets.
  assert_equal(
    expect_in_bounds(
      fn() {
        scalar_at(text, 2)
      },
      '\0'
    ),
    '中'
  )
  assert_equal(
    expect_in_bounds(
      fn() {
        slice(text, 1, 3)
      },
      ""
    ),
    "é中😀"
  )
  assert_equal(
    expect_in_bounds(
      fn() {
        slice(text, 5, 0)
      },
      "invalid"
    ),
    ""
  )
  // Invalid positions and ranges report through OutOfBound.
  assert_true(
    is_out_of_bounds[Char](
      fn() {
        scalar_at(text, -1)
      }
    )
  )
  assert_true(
    is_out_of_bounds[Char](
      fn() {
        scalar_at(text, 5)
      }
    )
  )
  assert_true(
    is_out_of_bounds[String](
      fn() {
        slice(text, 4, 2)
      }
    )
  )
  assert_true(
    is_out_of_bounds[String](
      fn() {
        slice(text, 1, 9223372036854775807)
      }
    )
  )
  // Folding preserves the callback effect and visits every scalar in order.
  let folded = foldl(
    text,
    "",
    fn(accumulator, scalar) {
      assert_true(true)
      concat(accumulator, to_string(scalar))
    }
  )
  assert_equal(folded, text)
}
