module Test.Data.List

import Basic.Data.List.*
import Basic.Data.I64.{ i64_impl_add, i64_impl_equal }
import Basic.Ops.{ op_add }
import Basic.Trait.Num.{ Add }
import Basic.Summon.{ summon, summon_via }
import Basic.Trait.Equal.{ Equal }
import Test.Assert.{ Assert }

fn test_length() -> Unit ! Assert {
  assert_eq!(length([1, 2, 3, 4]), 4, summon())
  assert_eq!(length[Unit]([]), 0, summon())
}

fn test_equal() -> Unit ! Assert {
  assert_eq!([1, 2, 3], [1, 2, 3], summon_via())
  assert_eq![List[I64]]([], [], summon_via())
  assert_not_eq!([1, 2, 3], [1, 2], summon_via())
}

fn test_map() -> Unit ! Assert {
  let l1 = [1, 2, 3]
  let l2 = map[I64, I64, {}](
    l1,
    fn(x) {
      x + 2
    }
  )
  assert_eq!(l2, [3, 4, 5], summon_via())
}

fn test_foldl() -> Unit ! Assert {
  let l1 = [1, 2, 3]
  let s = foldl(l1, 0, i64_impl_add.add)
  assert_eq!(s, 6, summon())
}

pub fn test_list() -> Unit ! Assert {
  test_length()
  test_equal()
  test_map()
  test_foldl()
}