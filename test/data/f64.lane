module Test.Data.F64

import Basic.Conv.F64.{ f64_impl_debug }
import Basic.Conv.I64.{ i64_impl_debug }
import Basic.Data.F64.*
import Basic.Data.I64.{ i64_impl_equal }
import Basic.Trait.Num.{ Add, Sub, Mul, Div, Neg }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ Compare }
import Basic.Ops.{ op_add, op_sub, op_mul, op_div, op_neg, op_less }
import Test.Assert.{ Assert, assert_equal, assert_true, assert_not_equal }

pub fn test_f64() -> Unit ! Assert {
  offer source_info : String = "test_f64"
  assert_equal(1.5 + 2.25, 3.75)
  assert_equal(4.0 - 1.5, 2.5)
  assert_equal(1.5 * 2.0, 3.0)
  assert_equal(7.5 / 2.5, 3.0)
  let negative : F64 = -1.5
  assert_equal(-negative, 1.5)
  assert_true(ninf < inf)
  // NaN is unordered and compares unequal to itself.
  assert_not_equal(nan, nan)
  assert_equal(from_i64(42), 42.0)
  // Conversion to I64 truncates toward zero.
  assert_equal(to_i64(42.75), 42)
}
