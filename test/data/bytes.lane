module Test.Data.Bytes

import Basic.Data.Bytes.*
import Basic.Builtins as Builtins
import Basic.Debug.I64.{ i64_impl_debug }
import Basic.Debug.Option.{ option_impl_debug }
import Basic.Data.Byte as Byte
import Basic.Data.String.{ string_impl_equal, encode_utf8, decode_utf8 }
import Basic.Data.Option.{ Option, option_impl_equal }
import Basic.Data.I64.{ i64_impl_equal }
import Basic.Debug.String.{ string_impl_debug }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Debug.{ Debug }
import Basic.Summon.{ summon_via }
import Test.Eff.Bound.{ expect_in_bounds, is_out_of_bounds }
import Test.Assert.{ Assert, assert_equal, assert_true }

pub fn test_utf8_and_bytes() -> Unit ! Assert {
  offer source_info : String = "test_string"
  assert_true(
    match Byte.from_i64(-1) {
      none() => true
      _ => false
    }
  )
  assert_true(
    match Byte.from_i64(256) {
      none() => true
      _ => false
    }
  )
  assert_true(
    match Byte.from_i64(255) {
      some(_) => true
      _ => false
    }
  )
  offer option_string_impl_debug : Debug[Option[String]] = summon_via[Debug, Option, String]()
  offer option_string_impl_equal : Equal[Option[String]] = summon_via()
  let empty = Builtins.bytes_make(0, Byte.wrapping_from_i64(0))
  let text = "Aé中😀\0"
  let encoded = encode_utf8(text)
  assert_equal(length(encoded), 11)
  assert_true(is_valid_utf8(encoded))
  assert_equal(decode_utf8(encoded), some(text))
  // A lone 0xFF byte is not valid UTF-8.
  let malformed = expect_in_bounds(
    fn() {
      make(1, Byte.wrapping_from_i64(255))
    },
    empty
  )
  assert_equal[Option[String]](decode_utf8(malformed), none())
  // Update returns a new sequence and leaves the original observable.
  let original = "abc"
  let original_bytes = encode_utf8(original)
  let changed = expect_in_bounds(
    fn() {
      set(original_bytes, 0, Byte.wrapping_from_i64(122))
    },
    empty
  )
  assert_equal(original, "abc")
  assert_equal(decode_utf8(changed), some("zbc"))
  // Slicing and concatenation round-trip the whole sequence.
  let prefix = expect_in_bounds(
    fn() {
      slice(encoded, 0, 6)
    },
    empty
  )
  let suffix = expect_in_bounds(
    fn() {
      slice(encoded, 6, 5)
    },
    empty
  )
  assert_true(equal(concat(prefix, suffix), encoded))
  assert_true(
    is_out_of_bounds[Bytes](
      fn() {
        slice(encoded, 10, 2)
      }
    )
  )
}
