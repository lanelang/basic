module Test.Entry

import Test.Assert.{ execute_all_tests }
import Test.Data.I32 as I32
import Test.Data.I64 as I64
import Test.Data.F64 as F64
import Test.Data.F32 as F32
import Test.Data.Char as Char
import Test.Data.String as String
import Test.Data.Bytes as Bytes
import Test.Data.Option as Option
import Test.Data.List as List
import Test.Eff.Write as Write

fn test_numbers_entry() -> Unit ! Io {
  fn() {
    I32.test_i32()
    I64.test_i64()
    F64.test_f64()
    F32.test_f32()
  } |> execute_all_tests()
}

fn test_char_entry() -> Unit ! Io {
  fn() {
    Char.test_char()
  } |> execute_all_tests()
}

fn test_string_entry() -> Unit ! Io {
  fn() {
    String.test_string()
  } |> execute_all_tests()
}

fn test_utf8_and_bytes_entry() -> Unit ! Io {
  fn() {
    Bytes.test_utf8_and_bytes()
  } |> execute_all_tests()
}

fn test_containers_entry() -> Unit ! Io {
  fn() {
    Option.test_equal()
    List.test_equal()
    List.test_length()
    List.test_map()
    List.test_foldl()
    Write.test_write_log()
  } |> execute_all_tests()
}

pub fn test_entry() -> Unit ! Io {
  test_numbers_entry()
  test_char_entry()
  test_string_entry()
  test_utf8_and_bytes_entry()
  test_containers_entry()
}
