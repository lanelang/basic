module Test.Entry

import Basic.Data.List.{ List }
import Test.Assert.{ execute_all_tests }
import Test.Assert.Summary as AssertSummary
import Test.Data.I32 as I32
import Test.Data.I64 as I64
import Test.Data.F64 as F64
import Test.Data.F32 as F32
import Test.Data.Char as Char
import Test.Data.String as String
import Test.Data.Bytes as Bytes
import Test.Data.Option as Option
import Test.Data.List as List
import Test.Data.AList as AList
import Test.Eff.Write as Write
import Test.Derive.Debug as Debug
import Test.System.Process as Process
import Test.Platform.Wasip1 as Wasip1
import Test.Build.Inspection as BuildInspection
import Test.Prelude as Prelude

pub fn test_entry() -> Unit ! { Io, Panic } {
  execute_all_tests(
    [
      AssertSummary.test_summary,
      I32.test_i32,
      I64.test_i64,
      F64.test_f64,
      F32.test_f32,
      Char.test_char,
      String.test_string,
      Bytes.test_utf8_and_bytes,
      Option.test_equal,
      List.test_list,
      AList.test_alist,
      Write.test_write_log,
      Debug.test_debug,
      BuildInspection.test_inspection,
      Prelude.test_prelude
    ]
  )
  execute_all_tests[{ Io }](
    [
      Process.test_missing_command,
      Process.test_inspect_source_output,
      Process.test_nonzero_exit_output,
      Wasip1.test_wasip1
    ]
  )
}
