module Test.Entry

import Test.Assert.{ Assert, execute_all_test }
import Test.Data.Option
import Test.Data.List
import Test.Data.State

pub fn test_entry() -> Unit ! Io {
  fn() {
    Test.Data.Option.test_equal()
    Test.Data.List.test_equal()
    Test.Data.List.test_length()
    Test.Data.State.test_run_effectful()
    Test.Data.State.test_run()
  } |> execute_all_test()
}
