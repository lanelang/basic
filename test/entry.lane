module Test.Entry

import Basic.Prelude.*
import Test.Assert.{ execute_all_tests }
import Test.Assert.Summary.{ test_summary as test_assert_summary }
import Test.Data.I32.{ test_i32 }
import Test.Data.I64.{ test_i64 }
import Test.Data.F64.{ test_f64 }
import Test.Data.F32.{ test_f32 }
import Test.Data.Char.{ test_char }
import Test.Data.String.{ test_string }
import Test.Data.Bytes.{ test_utf8_and_bytes as test_bytes }
import Test.Data.Option.{ test_equal as test_option }
import Test.Data.List.{ test_list }
import Test.Data.AList.{ test_alist }
import Test.Eff.Composition.{ test_composition }
import Test.Eff.Write.{ test_write_log }
import Test.Eff.Exn.{ test_exception_info }
import Test.Derive.Debug.{ test_debug }
import Test.System.Process.{ test_process }
import Test.Build.Inspection.{ test_inspection as test_build_inspection }
import Test.Build.Project.{ test_project_build }
import Test.Prelude.{ test_prelude }

pub fn test_entry() -> Unit ! { Io, Panic } {
  execute_all_tests(
    [
      test_assert_summary,
      test_i32,
      test_i64,
      test_f64,
      test_f32,
      test_char,
      test_string,
      test_bytes,
      test_option,
      test_list,
      test_alist,
      test_write_log,
      test_composition,
      test_exception_info,
      test_debug,
      test_process,
      test_build_inspection,
      test_project_build,
      test_prelude
    ]
  )
}
