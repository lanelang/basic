module Test.Entry

import Basic.Data.List.{ List }
import Test.Assert.{ execute_all_tests }
import Test.Data.I32 as I32
import Test.Data.I64 as I64
import Test.Data.F64 as F64
import Test.Data.F32 as F32
import Test.Data.Char as Char
import Test.Data.String as String
import Test.Data.Bytes as Bytes
import Test.Data.Option as Option
import Test.Data.List as List
import Test.Eff.Write as Write

pub fn test_entry() -> Unit ! Io {
  execute_all_tests([
    I32.test_i32,
    I64.test_i64,
    F64.test_f64,
    F32.test_f32,
    Char.test_char,
    String.test_string,
    Bytes.test_utf8_and_bytes,
    Option.test_equal,
    List.test_equal,
    List.test_length,
    List.test_map,
    List.test_foldl,
    Write.test_write_log
  ])
}
