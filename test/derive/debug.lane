module Test.Derive.Debug

import Basic.Derive.Debug.*
import Basic.Derive.*
import Basic.Trait.Debug.{ Debug, Document, render, debug }
import Basic.Conv.Unit.{ unit_impl_debug }
import Basic.Data.I32.{ wrapping_from_i64 as i64_to_i32 }
import Basic.Conv.I64.{ i64_impl_debug }
import Basic.Conv.I32.{ i32_impl_debug }
import Basic.Data.String.{ string_impl_equal, string_impl_debug }
import Test.Assert.{ Assert, assert_equal }
import Basic.Trait.Iso.{ Into }
import Basic.Trait.Debug.{ from_formatter }
import Basic.Builtins
import Basic.Data.I64.{ i64_impl_equal }
import Basic.Data.String
import Basic.Conv.Char.{ char_impl_debug }

fn test_debug_unit() -> Unit ! Assert {
  offer source_info : String = "test_debug_unit"
  assert_equal(debug(()), "()")
}

fn test_debug_i32() -> Unit ! Assert {
  offer source_info : String = "test_debug_i32"
  assert_equal(debug(i64_to_i32(42)), "42")
}

struct Point {
  x : I64
  y : I32
}

offer point_impl_debug : Debug[Point] = derive[Debug, Point]()

fn test_debug_derive_struct() -> Unit ! Assert {
  offer source_info : String = "test_debug_derive_struct"
  let point = Point::{ x: 1, y: 2i32 }
  assert_equal(debug(point), "Point::{ x: 1, y: 2 }")
}

pub fn test_debug() -> Unit ! Assert {
  test_debug_contract()
  test_document_depth()
  test_debug_unit()
  test_debug_i32()
  test_debug_derive_struct()
}

// Ordinary conversions must not participate in Debug resolution.

enum Message {
  text(String)
  empty()
}

offer message_impl_debug : Debug[Message] = derive[Debug, Message]()

struct EmptyDisplay {}

offer empty_display_debug : Debug[EmptyDisplay] = from_formatter(
  fn(_value) {
    ""
  }
)

enum Pair {
  both(EmptyDisplay, EmptyDisplay)
}

offer pair_impl_debug : Debug[Pair] = derive[Debug, Pair]()

fn test_debug_contract() -> Unit ! Assert {
  offer source_info : String = "debug contract"
  offer ordinary_conversion : Into[I64, String] = fn(_value) {
    "encoded"
  }
  assert_equal(ordinary_conversion(7), "encoded")
  assert_equal(debug(7), "7")
  assert_equal(debug(""), "\"\"")
  assert_equal(debug("a\n\t\"\\"), "\"a\\n\\t\\\"\\\\\"")
  assert_equal(debug('\n'), "'\\n'")
  assert_equal(debug(Message::text("")), "Message::text(\"\")")
  assert_equal(debug(Message::empty()), "Message::empty()")
  assert_equal(debug(Pair::both(EmptyDisplay::{}, EmptyDisplay::{})), "Pair::both(, )")
}

fn deep_document(n : I64, document : Document) -> Document {
  if Basic.Builtins.i64_equal(n, 0) {
    document
  } else {
    deep_document(Basic.Builtins.i64_sub(n, 1), Document::append(document, Document::text("x")))
  }
}

fn test_document_depth() -> Unit ! Assert {
  offer source_info : String = "balanced document rendering"
  assert_equal(
    render(
      Document::append(
        Document::text("a"),
        Document::append(Document::empty(), Document::text("b"))
      )
    ),
    "ab"
  )
  let rendered = render(deep_document(10000, Document::empty()))
  assert_equal(Basic.Data.String.byte_length(rendered), 10000)
  assert_equal(Basic.Data.String.byte_length(Basic.Data.String.quote(rendered, '"')), 10002)
}
