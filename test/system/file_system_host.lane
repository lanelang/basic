module Test.System.FileSystemHost

import Basic.Prelude.*
import Basic.System.FileSystem.{ FileSystemError, run_file_system, ensure_directory_exists }
import Basic.Io.{ println, panic }

fn check_directory(path : String) -> Unit ! { Io, Panic } {
  match
    run_file_system[Result[Unit, FileSystemError], {}](
      fn() {
        ensure_directory_exists(path)
      }
    ) {
    ok(_) => ()
    err(_) => absurd(panic("unable to create or reuse directory"))
  }
}

pub fn main() -> Unit ! { Io, Panic } {
  let invalid = run_file_system[Result[Unit, FileSystemError], {}](
    fn() {
      ensure_directory_exists("existing-file")
    }
  )
  match invalid {
    err(error) =>
      if error.code == 54i32 && error.path == "existing-file" {
        ()
      } else {
        absurd(panic("directory error lost its path or errno"))
      }
    _ => absurd(panic("accepted a regular file as a directory"))
  }
  check_directory("created-directory")
  check_directory("created-directory")
  println("filesystem host checks passed")
}
