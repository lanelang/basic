module Test.System.Process

import Basic.Builtins.{ bytes_to_string, string_to_bytes }
import Basic.Data.Option.{ Option }
import Basic.Data.String.{ string_impl_debug, string_impl_equal }
import Basic.System.Process.{
  Command,
  CommandOutput,
  CommandResult,
  Process,
  run_command,
  run_process_with
}
import Test.Assert.{ Assert, assert_equal, assert_true }

pub fn test_process() -> Unit ! { Assert, Panic } {
  offer source_info : String = "test_process"
  let action : () -> CommandOutput ! Process = fn() {
    run_command(
      Command::{
        executable: "lane",
        arguments: ["inspect", "build.lane"],
        working_directory: none(),
        environment: [],
        inherit_environment: true,
        stdin: string_to_bytes("")
      }
    )
  }
  let output = run_process_with(
    action,
    fn(command) {
      assert_equal(command.executable, "lane")
      assert_equal(bytes_to_string(command.stdin), "")
      CommandOutput::{
        result: exited(0i32),
        stdout: string_to_bytes("inspection"),
        stderr: string_to_bytes("")
      }
    }
  )
  assert_true(
    match output.result {
      exited(0i32) => true
      _ => false
    }
  )
  assert_equal(bytes_to_string(output.stdout), "inspection")
}
