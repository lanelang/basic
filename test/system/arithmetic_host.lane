module Test.System.ArithmeticHost

import Basic.Prelude.*
import Basic.Data.I64 as I64
import Basic.Data.I32 as I32
import Basic.Io.{ panic }

pub fn valid() -> Unit ! { Io, Panic } {
  if 84 / 2 == 42 {
    ()
  } else {
    absurd(panic("valid division failed"))
  }
}

pub fn divide_zero() -> Unit ! Panic {
  let _value = 1 / 0
  ()
}

pub fn divide_overflow() -> Unit ! Panic {
  let _value = I64.minimum / -1
  ()
}

pub fn remainder_zero() -> Unit ! Panic {
  let _value = 1 % 0
  ()
}

pub fn divide_i32_overflow() -> Unit ! Panic {
  let _value = I32.minimum / -1i32
  ()
}
