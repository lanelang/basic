module Test.Assert

import Basic.Data.List.{ List }
import Basic.Trait.Equal.{ Equal }
import Basic.Io.{ println }

pub effect Assert {
  assert_true(Bool) -> Unit
  assert_false(Bool) -> Unit
  assert_eq[T](T, T, Equal[T]) -> Unit
  assert_not_eq[T](T, T, Equal[T]) -> Unit
}

// Run one test function under the assertion handler.
fn[E : Effect] execute_test(f : () -> Unit ! { E, Assert }) -> Unit ! { E, Io } {
  handle f() with {
    assert_true(b, resume) =>
      if b {
        ()
      } else {
        println("assert error")
      } |> resume()
    assert_false(b, resume) =>
      if b {
        println("assert error")
      } else {
        ()
      } |> resume()
    assert_eq[_T](a, b, e, resume) =>
      if e.equal(a, b) {
        ()
      } else {
        println("assert error")
      } |> resume()
    assert_not_eq[_T](a, b, e, resume) =>
      if e.equal(a, b) {
        println("assert error")
      } else {
        ()
      } |> resume()
  } final _v {
    ()
  }
}

// Run every test function. Each one gets its own handler so that the resumption
// chain does not grow across tests.
pub fn[E : Effect] execute_all_tests(
  tests : List[() -> Unit ! { E, Assert }]
) -> Unit ! { E, Io } {
  match tests {
    empty() => ()
    cons(test, rest) => {
      execute_test(test)
      execute_all_tests(rest)
    }
  }
}
