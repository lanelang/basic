module Test.Assert

import Basic.Prelude.*
import Basic.Data.List.{ length as list_length }
import Basic.Data.String.{ concat }
import Basic.Io.{ println }
import Basic.Platform.Wasip1.{ proc_exit }

pub effect Assert {
  // assert(condition, source_info, fail_message)
  assert(Bool, String, String) -> Unit
}

pub fn assert_true(cond : Bool, auto info : String) -> Unit ! Assert {
  assert!(
    cond,
    "source info: "
      |> concat(info),
    "should be true, but is false"
  )
}

pub fn assert_false(cond : Bool, auto info : String) -> Unit ! Assert {
  assert!(
    !cond,
    "source info: "
      |> concat(info),
    "should be false, but is true"
  )
}

pub fn[T] assert_equal(
  lhs : T,
  rhs : T,
  auto info : String,
  auto offer debug_impl : Debug[T],
  auto offer equal_impl : Equal[T]
) -> Unit ! Assert {
  assert!(
    lhs == rhs,
    "source info: "
      |> concat(info),
    debug(lhs)
      |> concat(" != ")
      |> concat(debug(rhs))
  )
}

pub fn[T] assert_not_equal(
  lhs : T,
  rhs : T,
  auto info : String,
  auto offer debug_impl : Debug[T],
  auto offer equal_impl : Equal[T]
) -> Unit ! Assert {
  assert!(
    lhs != rhs,
    "source info: "
      |> concat(info),
    debug(lhs)
      |> concat(" == ")
      |> concat(debug(rhs))
  )
}

pub struct TestCounts {
  passed : I64
  failed : I64
}

pub fn format_test_summary(total : I64, counts : TestCounts) -> String {
  "Total tests: "
    |> concat(debug(total))
    |> concat(", passed: ")
    |> concat(debug(counts.passed))
    |> concat(", failed: ")
    |> concat(debug(counts.failed))
}

struct TestFailure {
  info : String
  message : String
}

enum TestOutcome {
  passed()
  failed(TestFailure)
}

struct TestReport {
  counts : TestCounts
  failures : List[TestFailure]
}

fn execute_test(f : () -> Unit ! { Assert, Panic }) -> TestOutcome ! Panic {
  handle f() with {
    assert(cond, info, msg, resume) => {
      if cond {
        resume(())
      } else {
        failed(TestFailure::{ info, message: msg })
      }
    }
  } final _v {
    passed()
  }
}

fn print_failures(failures : List[TestFailure]) -> Unit ! Io {
  match failures {
    empty() => ()
    cons(failure, rest) => {
      println(failure.info)
      println(failure.message)
      print_failures(rest)
    }
  }
}

pub fn execute_all_tests(tests : List[() -> Unit ! { Assert, Panic }]) -> Unit ! { Io, Panic } {
  let report = execute_tests(tests)
  print_failures(report.failures)
  println(format_test_summary(list_length(tests), report.counts))
  if report.counts.failed == 0 {
    ()
  } else {
    proc_exit(1i32)
  }
}

fn execute_tests(tests : List[() -> Unit ! { Assert, Panic }]) -> TestReport ! Panic {
  match tests {
    empty() => TestReport::{ counts: TestCounts::{ passed: 0, failed: 0 }, failures: [] }
    cons(test, rest) => {
      let outcome = execute_test(test)
      let report = execute_tests(rest)
      match outcome {
        passed() => TestReport::{
          counts: TestCounts::{ passed: report.counts.passed + 1, failed: report.counts.failed },
          failures: report.failures
        }
        failed(failure) => TestReport::{
          counts: TestCounts::{ passed: report.counts.passed, failed: report.counts.failed + 1 },
          failures: cons(failure, report.failures)
        }
      }
    }
  }
}
