module Test.Assert

import Basic.Conv.I64.{ i64_impl_debug }
import Basic.Data.Bool.{ bool_impl_not }
import Basic.Data.List.{ List }
import Basic.Data.I64.{ i64_impl_add }
import Basic.Data.String.{ concat }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Monoid.{ Monoid, Semigroup }
import Basic.Trait.Debug.{ debug }
import Basic.Io.{ println }
import Basic.Eff.Write.{ Write, run_write, WriteResult }
import Basic.Ops.{ op_not, op_add }

pub effect Assert {
  assert_true(Bool) -> Unit
  assert_false(Bool) -> Unit
  assert_eq[T](T, T, Equal[T]) -> Unit
  assert_not_eq[T](T, T, Equal[T]) -> Unit
}

pub struct TestCounts {
  passed : I64
  failed : I64
}

offer test_counts_impl_semigroup : Semigroup[TestCounts] = Semigroup::{
  append: fn(left, right) {
    TestCounts::{ passed: left.passed + right.passed, failed: left.failed + right.failed }
  }
}

offer test_counts_impl_monoid : Monoid[TestCounts] = Monoid::{
  semigroup_impl: test_counts_impl_semigroup,
  empty: TestCounts::{ passed: 0, failed: 0 }
}

// Run one test function under the assertion handler.
fn[E : Effect] execute_test(f : () -> Unit ! { E, Assert }) -> Bool ! E {
  handle f() with {
    assert_true(cond, resume) => {
      let rest_passed = resume(())
      if cond {
        rest_passed
      } else {
        false
      }
    }
    assert_false(cond, resume) => {
      let rest_passed = resume(())
      if !cond {
        rest_passed
      } else {
        false
      }
    }
    assert_eq[_T](a, b, e, resume) => {
      let rest_passed = resume(())
      if e.equal(a, b) {
        rest_passed
      } else {
        false
      }
    }
    assert_not_eq[_T](a, b, e, resume) => {
      let rest_passed = resume(())
      if e.equal(a, b) {
        false
      } else {
        rest_passed
      }
    }
  } final _v {
    true
  }
}

pub fn[E : Effect] execute_all_tests(tests : List[() -> Unit ! { E, Assert }]) -> Unit ! { E, Io } {
  let result =
    fn() {
      execute_tests(tests)
    } |> run_write[Unit, TestCounts, { E, Io }]
  let result = result()
  println(
    "Tests passed: "
      |> concat(debug(result.log.passed))
      |> concat(", failed: ")
      |> concat(debug(result.log.failed))
  )
}

fn[E : Effect] execute_tests(
  tests : List[() -> Unit ! { E, Assert }]
) -> Unit ! { E, Io, Write[TestCounts] } {
  match tests {
    empty() => ()
    cons(test, rest) => {
      if execute_test(test) {
        println("ok")
        write!(TestCounts::{ passed: 1, failed: 0 })
      } else {
        println("error")
        write!(TestCounts::{ passed: 0, failed: 1 })
      }
      execute_tests(rest)
    }
  }
}
