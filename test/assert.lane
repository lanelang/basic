module Test.Assert

import Basic.Trait.Equal.{ Equal }
import Basic.Io.{ println }

pub effect Assert {
  assert_true(Bool) -> Unit
  assert_false(Bool) -> Unit
  assert_eq[T](T, T, Equal[T]) -> Unit
  assert_not_eq[T](T, T, Equal[T]) -> Unit
}

pub fn[E : Effect] execute_all_tests(f : () -> Unit ! { E, Assert }) -> Unit ! { E, Io } {
  handle f() with {
    assert_true(b, resume) =>
      if b {
        ()
      } else {
        println("assert error")
      } |> resume()
    assert_false(b, resume) =>
      if b {
        println("assert error")
      } else {
        ()
      } |> resume()
    assert_eq[_T](a, b, e, resume) =>
      if e.equal(a, b) {
        ()
      } else {
        println("assert error")
      } |> resume()
    assert_not_eq[_T](a, b, e, resume) =>
      if e.equal(a, b) {
        println("assert error")
      } else {
        ()
      } |> resume()
  } final _v {
    ()
  }
}
