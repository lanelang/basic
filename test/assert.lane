module Test.Assert

import Basic.Conv.I64.{ i64_impl_debug }
import Basic.Data.Bool.{ bool_impl_not }
import Basic.Data.List.{ List }
import Basic.Data.I64.{ i64_impl_add }
import Basic.Data.String.{ concat }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Monoid.{ Monoid, Semigroup }
import Basic.Trait.Debug.{ debug, Debug }
import Basic.Io.{ println }
import Basic.Eff.Write.{ Write, run_write, WriteResult }
import Basic.Ops.{ op_not, op_add, op_equal, op_not_equal }

pub effect Assert {
  // assert(condition, source_info, fail_message)
  assert(Bool, String, String) -> Unit
}

pub fn assert_true(cond : Bool, auto info : String) -> Unit ! Assert {
  assert!(
    cond,
    "source info: "
      |> concat(info),
    "should be true, but is false"
  )
}

pub fn assert_false(cond : Bool, auto info : String) -> Unit ! Assert {
  assert!(
    !cond,
    "source info: "
      |> concat(info),
    "should be false, but is true"
  )
}

pub fn[T] assert_equal(
  lhs : T,
  rhs : T,
  auto info : String,
  auto offer debug_impl : Debug[T],
  auto offer equal_impl : Equal[T]
) -> Unit ! Assert {
  assert!(
    lhs == rhs,
    "source info: "
      |> concat(info),
    "lhs"
      |> concat(debug(lhs))
      |> concat(" != ")
      |> concat(debug(rhs))
  )
}

pub fn[T] assert_not_equal(
  lhs : T,
  rhs : T,
  auto info : String,
  auto offer debug_impl : Debug[T],
  auto offer equal_impl : Equal[T]
) -> Unit ! Assert {
  assert!(
    lhs != rhs,
    "source info: "
      |> concat(info),
    "lhs"
      |> concat(debug(lhs))
      |> concat(" == ")
      |> concat(debug(rhs))
  )
}

pub struct TestCounts {
  passed : I64
  failed : I64
}

offer test_counts_impl_semigroup : Semigroup[TestCounts] = Semigroup::{
  append: fn(left, right) {
    TestCounts::{ passed: left.passed + right.passed, failed: left.failed + right.failed }
  }
}

offer test_counts_impl_monoid : Monoid[TestCounts] = Monoid::{
  semigroup_impl: test_counts_impl_semigroup,
  empty: TestCounts::{ passed: 0, failed: 0 }
}

// Run one test function under the assertion handler.
fn[E : Effect] execute_test(f : () -> Unit ! { E, Assert }) -> Unit ! { E, Io, Write[TestCounts] } {
  handle f() with {
    assert(cond, info, msg, resume) => {
      if cond {
        resume(())
      } else {
        println(info)
        println(msg)
      }
    }
  } final _v {
    ()
  }
}

pub fn[E : Effect] execute_all_tests(tests : List[() -> Unit ! { E, Assert }]) -> Unit ! { E, Io } {
  let result =
    fn() {
      execute_tests(tests)
    } |> run_write[Unit, TestCounts, { E, Io }]
  let result = result()
  println(
    "Tests passed: "
      |> concat(debug(result.log.passed))
      |> concat(", failed: ")
      |> concat(debug(result.log.failed))
  )
}

fn[E : Effect] execute_tests(
  tests : List[() -> Unit ! { E, Assert }]
) -> Unit ! { E, Io, Write[TestCounts] } {
  match tests {
    empty() => ()
    cons(test, rest) => {
      execute_test(test)
      execute_tests(rest)
    }
  }
}
