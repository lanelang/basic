module Basic.Data.List

import Basic.Trait.Map.{ Mappable }
import Basic.Eff.Out.{ OutOfBound }
import Basic.Trait.Ops.{ Equal, op_add, op_equal, op_less, op_sub }

pub enum List[T] {
  empty()
  cons(T, List[T])
}

pub fn[T] length(list : List[T]) -> Int {
  match list {
    empty() => 0
    cons(_x, xs) => length(xs) + 1
  }
}

pub fn[T, R, E : Effect] map(list : List[T], f : (T) -> R ! E) -> List[R] ! E {
  match list {
    empty() => empty()
    cons(x, xs) => cons(f(x), map(xs, f))
  }
}

pub offer list_impl_mappable : Mappable[List] = Mappable::{ map }

pub fn[T] elem(list : List[T], index : Int) -> T ! OutOfBound {
  if index < 0 {
    out_of_min!()
  } else if index == 0 {
    match list {
      empty() => out_of_min!()
      cons(x, _xs) => x
    }
  } else {
    match list {
      empty() => out_of_max!()
      cons(_x, xs) => elem(xs, index - 1)
    }
  }
}

pub fn[T] push(list : List[T], elem : T) -> List[T] {
  match list {
    empty() => cons(elem, empty())
    cons(_x, xs) => push(xs, elem)
  }
}

pub fn[T] filter(list : List[T], pred : (T) -> Bool) -> List[T] {
  match list {
    empty() => empty()
    cons(x, xs) =>
      if pred(x) {
        filter(xs, pred)
      } else {
        cons(x, filter(xs, pred))
      }
  }
}
