module Basic.Data.AssociatedList

import Basic.Data.List.{ List, push_head, filter }
import Basic.Data.Pair.{ Pair }
import Basic.Data.Option.{ Option }
import Basic.Trait.Ops.{ Equal, op_equal, op_not_equal }
import Basic.Trait.Table.{ Table }

pub type AssocList[A, B] = List[Pair[A, B]]

pub fn[A, B] empty() -> AssocList[A, B] {
  List::empty()
}

pub fn[K, V] get(list : AssocList[K, V], key : K, auto offer equal_impl : Equal[K]) -> Option[V] {
  match list {
    empty() => none()
    cons(Pair::{ fst, snd }, xs) =>
      if fst == key {
        some(snd)
      } else {
        get(xs, key, equal_impl=equal_impl)
      }
  }
}

pub fn[K, V] set(
  list : AssocList[K, V],
  key : K,
  val : V,
  auto _equal_impl : Equal[K]
) -> AssocList[K, V] {
  push_head(list, Pair::{ fst: key, snd: val })
}

pub fn[K, V] del(
  list : AssocList[K, V],
  key : K,
  auto offer equal_impl : Equal[K]
) -> AssocList[K, V] {
  filter(
    list,
    fn(e) {
      e.fst != key
    }
  )
}

pub fn[K, V] assoc_list_impl_table(auto key_equal_impl : Equal[K]) -> Table[AssocList[K, V]] {
  Table::{
    K = K,
    V = V,
    key_equal_impl,
    set: fn(t, k, v) {
      set(t, k, v, _equal_impl=key_equal_impl)
    },
    get: fn(t, k) {
      get(t, k, equal_impl=key_equal_impl)
    },
    del: fn(t, k) {
      del(t, k, equal_impl=key_equal_impl)
    }
  }
}
