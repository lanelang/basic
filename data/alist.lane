module Basic.Data.AList

import Basic.Data.List.{ List, push_head, filter, find }
import Basic.Data.Pair.{ Pair }
import Basic.Data.Option.{ Option, map }
import Basic.Trait.Ops.{ Equal, op_equal, op_not_equal }
import Basic.Trait.Table.{ Table }

pub type AList[A, B] = List[Pair[A, B]]

pub fn[A, B] empty() -> AList[A, B] {
  List::empty()
}

pub fn[K, V] get(list : AList[K, V], key : K, auto offer equal_impl : Equal[K]) -> Option[V] {
  find(
    list,
    fn(e) {
      e.fst == key
    }
  ) |> map(
      fn(e) {
        e.snd
      }
    )
}

pub fn[K, V] set(list : AList[K, V], key : K, val : V, auto _equal_impl : Equal[K]) -> AList[K, V] {
  push_head(list, Pair::{ fst: key, snd: val })
}

pub fn[K, V] del(list : AList[K, V], key : K, auto offer equal_impl : Equal[K]) -> AList[K, V] {
  filter(
    list,
    fn(e) {
      e.fst != key
    }
  )
}

pub fn[K, V] assoc_list_impl_table(auto offer key_equal_impl : Equal[K]) -> Table[AList[K, V]] {
  Table::{
    K = K,
    V = V,
    key_equal_impl,
    empty: fn() {
      empty()
    },
    set: fn(t, k, v) {
      set(t, k, v)
    },
    get: fn(t, k) {
      get(t, k)
    },
    del: fn(t, k) {
      del(t, k)
    }
  }
}
