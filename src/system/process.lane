module Basic.System.Process

import Basic.Builtins.{
  bytes_length,
  bytes_slice,
  i32_equal,
  i32_to_i64,
  i64_add,
  i64_mul,
  i64_to_i32,
  string_to_bytes
}
import Basic.Data.List.{ List, length as list_length }
import Basic.Data.Option.{ Option }
import Basic.Wasm.Abi.{
  WasmAddress,
  address as buffer_address,
  allocate as allocate_buffer,
  read_i32 as read_buffer_i32,
  to_bytes as buffer_to_bytes,
  write_bytes as write_buffer_bytes,
  write_i32 as write_buffer_i32
}

pub struct EnvironmentVariable {
  key : String
  value : String
}

pub struct Command {
  executable : String
  arguments : List[String]
  working_directory : Option[String]
  environment : List[EnvironmentVariable]
  inherit_environment : Bool
  stdin : Bytes
}

pub enum CommandResult {
  exited(I32)
  signaled(I32)
  invalid_request()
  executable_not_found()
  permission_denied()
  system_failure()
}

pub struct CommandOutput {
  result : CommandResult
  stdout : Bytes
  stderr : Bytes
}

pub effect Process {
  execute(Command) -> CommandOutput
}

pub fn run_command(command : Command) -> CommandOutput ! Process {
  execute!(command)
}

pub fn[T, E : Effect, AdapterEffect : Effect] run_process_with(
  action : () -> T ! { E, Process },
  adapter : (Command) -> CommandOutput ! AdapterEffect
) -> () -> T ! { E, AdapterEffect } {
  fn() {
    handle action() with {
      execute(command, resume) => resume(adapter(command))
    } final value {
      value
    }
  }
}

pub fn[T, E : Effect] run_process(action : () -> T ! { E, Process }) -> () -> T ! { E, Io } {
  run_process_with[T, E, { Io }](action, execute_command_on_host)
}

let run_command_raw : (WasmAddress, I32, WasmAddress) -> I32 ! Io =
  extern("lane_runtime_v1", "run_command")

let take_command_output_raw : (I32, WasmAddress, I32) -> I32 ! Io =
  extern("lane_runtime_v1", "take_command_output")

fn string_size(value : String) -> I64 {
  bytes_length(string_to_bytes(value))
}

fn string_list_size(values : List[String]) -> I64 {
  match values {
    empty() => 0
    cons(value, rest) => i64_add(string_size(value), string_list_size(rest))
  }
}

fn environment_size(values : List[EnvironmentVariable]) -> I64 {
  match values {
    empty() => 0
    cons(value, rest) => i64_add(
      i64_add(string_size(value.key), string_size(value.value)),
      environment_size(rest)
    )
  }
}

fn working_directory_size(directory : Option[String]) -> I64 {
  match directory {
    none() => 0
    some(value) => string_size(value)
  }
}

fn write_frame_i32(frame : ByteBuffer, request_start : I64, offset : I64, value : I64) -> Unit ! Io {
  write_buffer_i32(frame, i64_add(request_start, offset), i64_to_i32(value))
}

fn write_frame_bytes(
  frame : ByteBuffer,
  request_start : I64,
  offset : I64,
  value : String
) -> Unit ! Io {
  write_buffer_bytes(frame, i64_add(request_start, offset), string_to_bytes(value))
}

fn write_arguments(
  frame : ByteBuffer,
  request_start : I64,
  arguments : List[String],
  table_offset : I64,
  payload_offset : I64
) -> Unit ! Io {
  match arguments {
    empty() => ()
    cons(argument, rest) => {
      let length = string_size(argument)
      write_frame_i32(frame, request_start, table_offset, payload_offset)
      write_frame_i32(frame, request_start, i64_add(table_offset, 4), length)
      write_frame_bytes(frame, request_start, payload_offset, argument)
      write_arguments(
        frame,
        request_start,
        rest,
        i64_add(table_offset, 8),
        i64_add(payload_offset, length)
      )
    }
  }
}

fn write_environment(
  frame : ByteBuffer,
  request_start : I64,
  environment : List[EnvironmentVariable],
  table_offset : I64,
  payload_offset : I64
) -> Unit ! Io {
  match environment {
    empty() => ()
    cons(variable, rest) => {
      let key_length = string_size(variable.key)
      let value_length = string_size(variable.value)
      let value_offset = i64_add(payload_offset, key_length)
      write_frame_i32(frame, request_start, table_offset, payload_offset)
      write_frame_i32(frame, request_start, i64_add(table_offset, 4), key_length)
      write_frame_i32(frame, request_start, i64_add(table_offset, 8), value_offset)
      write_frame_i32(frame, request_start, i64_add(table_offset, 12), value_length)
      write_frame_bytes(frame, request_start, payload_offset, variable.key)
      write_frame_bytes(frame, request_start, value_offset, variable.value)
      write_environment(
        frame,
        request_start,
        rest,
        i64_add(table_offset, 16),
        i64_add(value_offset, value_length)
      )
    }
  }
}

fn execute_command_on_host(command : Command) -> CommandOutput ! Io {
  let response_size = 20
  let request_header_size = 44
  let argument_count = list_length(command.arguments)
  let environment_count = list_length(command.environment)
  let argument_table_offset = request_header_size
  let environment_table_offset = i64_add(argument_table_offset, i64_mul(argument_count, 8))
  let executable_offset = i64_add(environment_table_offset, i64_mul(environment_count, 16))
  let executable_length = string_size(command.executable)
  let arguments_payload_offset = i64_add(executable_offset, executable_length)
  let working_directory_offset =
    i64_add(arguments_payload_offset, string_list_size(command.arguments))
  let environment_payload_offset =
    i64_add(working_directory_offset, working_directory_size(command.working_directory))
  let stdin_offset = i64_add(environment_payload_offset, environment_size(command.environment))
  let stdin_length = bytes_length(command.stdin)
  let request_size = i64_add(stdin_offset, stdin_length)
  let frame = allocate_buffer(i64_add(response_size, request_size))
  let flags = if command.inherit_environment {
    1
  } else {
    0
  }
  write_frame_i32(frame, response_size, 0, flags)
  write_frame_i32(frame, response_size, 4, executable_offset)
  write_frame_i32(frame, response_size, 8, executable_length)
  write_frame_i32(frame, response_size, 12, argument_table_offset)
  write_frame_i32(frame, response_size, 16, argument_count)
  match command.working_directory {
    none() => {
      write_frame_i32(frame, response_size, 20, -1)
      write_frame_i32(frame, response_size, 24, 0)
    }
    some(directory) => {
      write_frame_i32(frame, response_size, 20, working_directory_offset)
      write_frame_i32(frame, response_size, 24, string_size(directory))
      write_frame_bytes(frame, response_size, working_directory_offset, directory)
    }
  }
  write_frame_i32(frame, response_size, 28, environment_table_offset)
  write_frame_i32(frame, response_size, 32, environment_count)
  write_frame_i32(frame, response_size, 36, stdin_offset)
  write_frame_i32(frame, response_size, 40, stdin_length)
  write_frame_bytes(frame, response_size, executable_offset, command.executable)
  write_arguments(
    frame,
    response_size,
    command.arguments,
    argument_table_offset,
    arguments_payload_offset
  )
  write_environment(
    frame,
    response_size,
    command.environment,
    environment_table_offset,
    environment_payload_offset
  )
  write_buffer_bytes(frame, i64_add(response_size, stdin_offset), command.stdin)
  let status =
    run_command_raw(
      buffer_address(frame, 20i32),
      i64_to_i32(request_size),
      buffer_address(frame, 0i32)
    )
  let empty = string_to_bytes("")
  if i32_equal(status, 0i32) {
    let kind = read_buffer_i32(frame, 0)
    let code = read_buffer_i32(frame, 4)
    let output_handle = read_buffer_i32(frame, 8)
    let stdout_length = i32_to_i64(read_buffer_i32(frame, 12))
    let stderr_length = i32_to_i64(read_buffer_i32(frame, 16))
    let output_length = i64_add(stdout_length, stderr_length)
    let output_buffer = allocate_buffer(output_length)
    let output_status =
      take_command_output_raw(
        output_handle,
        buffer_address(output_buffer, 0i32),
        i64_to_i32(output_length)
      )
    if i32_equal(output_status, 0i32) {
      let output = buffer_to_bytes(output_buffer)
      let result = if i32_equal(kind, 0i32) {
        exited(code)
      } else {
        signaled(code)
      }
      CommandOutput::{
        result,
        stdout: bytes_slice(output, 0, stdout_length),
        stderr: bytes_slice(output, stdout_length, stderr_length)
      }
    } else {
      CommandOutput::{ result: system_failure(), stdout: empty, stderr: empty }
    }
  } else if i32_equal(status, 1i32) {
    CommandOutput::{ result: invalid_request(), stdout: empty, stderr: empty }
  } else if i32_equal(status, 2i32) {
    CommandOutput::{ result: executable_not_found(), stdout: empty, stderr: empty }
  } else if i32_equal(status, 3i32) {
    CommandOutput::{ result: permission_denied(), stdout: empty, stderr: empty }
  } else {
    CommandOutput::{ result: system_failure(), stdout: empty, stderr: empty }
  }
}
