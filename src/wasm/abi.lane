module Basic.Wasm.Abi

import Basic.Builtins.{
  byte_buffer_make,
  byte_buffer_read_i32,
  byte_buffer_to_bytes,
  byte_buffer_write_address,
  byte_buffer_write_bytes,
  byte_buffer_write_i32
}

// The canonical guest-address carrier accepted by raw Wasm extern parameters.
// It is deliberately not convertible to I32 in Lane source.
pub struct WasmAddress {
  storage : ByteBuffer
  offset : I32
}

pub fn allocate(size : I64) -> ByteBuffer ! Io {
  byte_buffer_make(size)
}

pub fn address(storage : ByteBuffer, offset : I32) -> WasmAddress {
  WasmAddress::{ storage, offset }
}

pub fn write_bytes(storage : ByteBuffer, destination : I64, source : Bytes) -> Unit ! Io {
  byte_buffer_write_bytes(storage, destination, source)
}

pub fn write_i32(storage : ByteBuffer, index : I64, value : I32) -> Unit ! Io {
  byte_buffer_write_i32(storage, index, value)
}

pub fn write_address(
  storage : ByteBuffer,
  index : I64,
  target : ByteBuffer,
  target_offset : I32
) -> Unit ! Io {
  byte_buffer_write_address(storage, index, target, target_offset)
}

pub fn read_i32(storage : ByteBuffer, index : I64) -> I32 ! Io {
  byte_buffer_read_i32(storage, index)
}

pub fn to_bytes(storage : ByteBuffer) -> Bytes ! Io {
  byte_buffer_to_bytes(storage)
}
