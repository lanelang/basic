module Basic.Data.Result

import Basic.Data.Tuple.{ Tuple }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Map.{ Mappable }
import Basic.Trait.App.{ Applicative }
import Basic.Trait.Flat.{ FlatMappable }

pub enum Result[T, E] {
  ok(T)
  err(E)
}

pub offer fn[T, E] result_impl_equal(
  auto offer t : Equal[T],
  auto offer e : Equal[E]
) -> Equal[Result[T, E]] {
  Equal::{
    equal: fn(left, right) {
      match (left, right) {
        (ok(a), ok(b)) => t.equal(a, b)
        (err(a), err(b)) => e.equal(a, b)
        _ => false
      }
    }
  }
}

pub fn[L, Err, T, Eff : Effect] map(
  result : Result[L, Err],
  f : (L) -> T ! Eff
) -> Result[T, Err] ! Eff {
  match result {
    ok(v) => ok(f(v))
    err(e) => err(e)
  }
}

pub fn[L, R] pure(x : L) -> Result[L, R] {
  ok(x)
}

pub fn[L, Err, T, Eff : Effect] apply(
  result : Result[L, Err],
  f : Result[(L) -> T ! Eff, Err]
) -> Result[T, Err] ! Eff {
  match result {
    err(e) => err(e)
    ok(o) =>
      match f {
        err(fe) => err(fe)
        ok(fo) => ok(fo(o))
      }
  }
}

pub type PartialResult[E] = type[T] => Result[T, E]

pub offer fn[E] result_impl_mappable() -> Mappable[PartialResult[E]] {
  Mappable::{
    map: fn[T, R, Eff : Effect](res : PartialResult[E][T], f : (T) -> R ! Eff) {
      map[T, E, R, Eff](res, f)
    }
  }
}

// A failed value bypasses the callback. This Result uses fail-fast sequencing.
pub fn[T, R, Err, E : Effect] flat_map(
  value : Result[T, Err],
  f : (T) -> Result[R, Err] ! E
) -> Result[R, Err] ! E {
  match value {
    ok(value) => f(value)
    err(error) => Result[R, Err]::err(error)
  }
}

pub fn[T, Err, Other, E : Effect] map_err(
  value : Result[T, Err],
  f : (Err) -> Other ! E
) -> Result[T, Other] ! E {
  match value {
    ok(value) => Result[T, Other]::ok(value)
    err(error) => Result[T, Other]::err(f(error))
  }
}

pub fn[T, Err] get_or(value : Result[T, Err], fallback : T) -> T {
  match value {
    ok(value) => value
    err(_) => fallback
  }
}

pub fn[T, Err, E : Effect] get_or_else(value : Result[T, Err], fallback : (Err) -> T ! E) -> T ! E {
  match value {
    ok(value) => value
    err(error) => fallback(error)
  }
}

pub fn[T, Err, Other, E : Effect] or_else(
  value : Result[T, Err],
  fallback : (Err) -> Result[T, Other] ! E
) -> Result[T, Other] ! E {
  match value {
    ok(value) => Result[T, Other]::ok(value)
    err(error) => fallback(error)
  }
}

pub fn[T, Err] is_ok(value : Result[T, Err]) -> Bool {
  match value {
    ok(_) => true
    err(_) => false
  }
}

pub fn[T, Err] is_err(value : Result[T, Err]) -> Bool {
  match value {
    ok(_) => false
    err(_) => true
  }
}

pub offer fn[Err] result_impl_applicative() -> Applicative[PartialResult[Err]] {
  Applicative::{
    mappable_impl: result_impl_mappable[Err](),
    pure: fn[T](value) {
      Result[T, Err]::ok(value)
    },
    apply: fn[T, R, E : Effect](value, function) {
      apply[T, Err, R, E](value, function)
    }
  }
}

pub offer fn[Err] result_impl_flat_mappable() -> FlatMappable[PartialResult[Err]] {
  FlatMappable::{
    applicative_impl: result_impl_applicative[Err](),
    flat_map: fn[T, R, E : Effect](value, f) {
      flat_map[T, R, Err, E](value, f)
    }
  }
}
