module Basic.Data.Tuple

import Basic.Trait.Equal.{ Equal }

pub enum Tuple[A, B] {
  tuple(A, B)
}

pub offer fn[A, B] tuple_impl_equal(auto a : Equal[A], auto b : Equal[B]) -> Equal[Tuple[A, B]] {
  Equal::{
    equal: fn(left, right) {
      let tuple(lx, ly) = left
      let tuple(rx, ry) = right
      if a.equal(lx, rx) {
        b.equal(ly, ry)
      } else {
        false
      }
    }
  }
}

pub fn[A, B] fst(tp : (A, B)) -> A {
  let tuple(x, _y) = tp
  x
}

pub fn[A, B] snd(tp : (A, B)) -> B {
  let tuple(_x, y) = tp
  y
}
