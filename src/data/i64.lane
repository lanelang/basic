module Basic.Data.I64

import Basic.Trait.Num.{ Add, Sub, Mul, Div, Rem, Neg, ArithmeticError }
import Basic.Data.Result.{ Result }
import Basic.Data.Void.{ Void, absurd }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ PartialCompare, TotalCompare, Ordering }
import Basic.Builtins.{ i64_add, i64_sub, i64_mul, i64_div, i64_rem, i64_neg, i64_equal, i64_less }

pub let maximum : I64 = 9223372036854775807

pub let minimum : I64 = -9223372036854775808

pub offer i64_impl_add : Add[I64] = Add::{ add: i64_add }

pub offer i64_impl_sub : Sub[I64] = Sub::{ sub: i64_sub }

pub offer i64_impl_mul : Mul[I64] = Mul::{ mul: i64_mul }

pub offer i64_impl_div : Div[I64] = Div::{ div: divide }

pub offer i64_impl_rem : Rem[I64] = Rem::{ rem: remainder }

pub offer i64_impl_neg : Neg[I64] = Neg::{ neg: i64_neg }

pub offer i64_impl_equal : Equal[I64] = Equal::{ equal: i64_equal }

pub offer i64_impl_compare : PartialCompare[I64] = PartialCompare::{
  equal_impl: i64_impl_equal,
  less: i64_less
}

pub offer i64_impl_total_compare : TotalCompare[I64] = TotalCompare::{
  compare: fn(a, b) {
    if i64_equal(a, b) {
      Ordering::equal()
    } else if i64_less(a, b) {
      Ordering::less()
    } else {
      Ordering::greater()
    }
  }
}

let abort : () -> Void ! Panic = builtin("%abort")

pub fn checked_div(a : I64, b : I64) -> Result[I64, ArithmeticError] {
  if i64_equal(b, 0) {
    err(zero_divisor())
  } else if i64_equal(a, minimum) {
    if i64_equal(b, -1) {
      err(overflow())
    } else {
      ok(i64_div(a, b))
    }
  } else {
    ok(i64_div(a, b))
  }
}

pub fn checked_rem(a : I64, b : I64) -> Result[I64, ArithmeticError] {
  if i64_equal(b, 0) {
    err(zero_divisor())
  } else {
    ok(i64_rem(a, b))
  }
}

// Invalid integer arithmetic terminates explicitly; use checked_* to recover.
pub fn divide(a : I64, b : I64) -> I64 ! Panic {
  match checked_div(a, b) {
    ok(value) => value
    err(_) => absurd(abort())
  }
}

pub fn remainder(a : I64, b : I64) -> I64 ! Panic {
  match checked_rem(a, b) {
    ok(value) => value
    err(_) => absurd(abort())
  }
}
