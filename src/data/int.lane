module Basic.Data.Int

import Basic.Trait.Num.{ Add, Sub, Mul, Div, Rem, Neg }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ Compare }
import Basic.Builtins.{ int_add, int_sub, int_mul, int_div, int_rem, int_neg, int_equal, int_less }

pub offer int_impl_add : Add[Int] = Add::{ add: int_add }

pub offer int_impl_sub : Sub[Int] = Sub::{ sub: int_sub }

pub offer int_impl_mul : Mul[Int] = Mul::{ mul: int_mul }

pub offer int_impl_div : Div[Int] = Div::{ div: int_div }

pub offer int_impl_rem : Rem[Int] = Rem::{ rem: int_rem }

pub offer int_impl_neg : Neg[Int] = Neg::{ neg: int_neg }

pub offer int_impl_equal : Equal[Int] = Equal::{ equal: int_equal }

pub offer int_impl_compare : Compare[Int] = Compare::{ equal_impl: int_impl_equal, less: int_less }
