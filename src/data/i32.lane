module Basic.Data.I32

import Basic.Trait.Num.{ Add, Sub, Mul, Div, Rem, Neg }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ PartialCompare, TotalCompare, Ordering }
import Basic.Builtins.{ i32_add, i32_sub, i32_mul, i32_div, i32_rem, i32_neg, i32_equal, i32_less }

pub let maximum : I32 = 2147483647i32

pub let minimum : I32 = -2147483648i32

pub offer i32_impl_add : Add[I32] = Add::{ add: i32_add }

pub offer i32_impl_sub : Sub[I32] = Sub::{ sub: i32_sub }

pub offer i32_impl_mul : Mul[I32] = Mul::{ mul: i32_mul }

pub offer i32_impl_div : Div[I32] = Div::{ div: i32_div }

pub offer i32_impl_rem : Rem[I32] = Rem::{ rem: i32_rem }

pub offer i32_impl_neg : Neg[I32] = Neg::{ neg: i32_neg }

pub offer i32_impl_equal : Equal[I32] = Equal::{ equal: i32_equal }

pub offer i32_impl_compare : PartialCompare[I32] = PartialCompare::{
  equal_impl: i32_impl_equal,
  less: i32_less
}

pub offer i32_impl_total_compare : TotalCompare[I32] = TotalCompare::{
  compare: fn(a, b) {
    if i32_equal(a, b) {
      Ordering::equal()
    } else if i32_less(a, b) {
      Ordering::less()
    } else {
      Ordering::greater()
    }
  }
}
