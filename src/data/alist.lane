module Basic.Data.AList

import Basic.Data.List.{ List, push_head, filter as filter_list, find as find_list }
import Basic.Data.Tuple.{ Tuple, fst, snd }
import Basic.Data.Option.{ Option, map as map_option }
import Basic.Trait.Equal.{ Equal }
import Basic.Ops.{ op_equal, op_not_equal }

pub type AList[A, B] = List[(A, B)]

pub fn[A, B] empty() -> AList[A, B] {
  List::empty()
}

pub fn[K, V] get(list : AList[K, V], key : K, auto offer equal_impl : Equal[K]) -> Option[V] {
  find_list(
    list,
    fn(e) {
      fst(e) == key
    }
  ) |> map_option(
      fn(e) {
        snd(e)
      }
    )
}

// Replace every previous binding for key and place its new binding first.
// Unrelated bindings retain their order. Linear in the input length.
pub fn[K, V] set(
  list : AList[K, V],
  key : K,
  val : V,
  auto offer equal_impl : Equal[K]
) -> AList[K, V] {
  bind(del(list, key), key, val)
}

// Constant-time lexical shadowing. Duplicate keys are intentional; get uses the first.
pub fn[K, V] bind(list : AList[K, V], key : K, val : V) -> AList[K, V] {
  push_head(list, (key, val))
}

pub fn[K, V] del(list : AList[K, V], key : K, auto offer equal_impl : Equal[K]) -> AList[K, V] {
  filter_list(
    list,
    fn(e) {
      fst(e) != key
    }
  )
}
