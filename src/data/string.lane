module Basic.Data.String

import Basic.Ops.{ op_add, op_sub, op_mul, op_equal, op_less }
import Basic.Builtins as Builtins
import Basic.Data.I64.{ i64_impl_add, i64_impl_sub, i64_impl_mul, i64_impl_equal, i64_impl_compare }
import Basic.Data.I32.{ i32_impl_equal, i32_impl_compare }
import Basic.Data.Char as Char
import Basic.Data.Option.{ Option }
import Basic.Eff.Bound.{ OutOfBound }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ Compare }
import Basic.Trait.Monoid.{ Monoid, Semigroup }

fn byte_value(bytes : Bytes, index : I64) -> I64 {
  Builtins.byte_to_i64(Builtins.bytes_get(bytes, index))
}

fn utf8_width(bytes : Bytes, offset : I64) -> I64 {
  let first = byte_value(bytes, offset)
  if first < 128 {
    1
  } else if first < 224 {
    2
  } else if first < 240 {
    3
  } else {
    4
  }
}

fn decode_scalar(bytes : Bytes, offset : I64) -> Char {
  let first = byte_value(bytes, offset)
  let width = utf8_width(bytes, offset)
  let scalar = if width == 1 {
    first
  } else if width == 2 {
    (first - 192) * 64 + (byte_value(bytes, offset + 1) - 128)
  } else if width == 3 {
    (first - 224) * 4096 + (byte_value(bytes, offset + 1) - 128) * 64
      + (byte_value(bytes, offset + 2) - 128)
  } else {
    (first - 240) * 262144 + (byte_value(bytes, offset + 1) - 128) * 4096
      + (byte_value(bytes, offset + 2) - 128) * 64
      + (byte_value(bytes, offset + 3) - 128)
  }
  Builtins.i32_to_char(Builtins.i64_to_i32(scalar))
}

fn count_scalars(bytes : Bytes, offset : I64, count : I64) -> I64 {
  if offset == Builtins.bytes_length(bytes) {
    count
  } else {
    count_scalars(bytes, offset + utf8_width(bytes, offset), count + 1)
  }
}

fn advance_scalars(bytes : Bytes, offset : I64, count : I64) -> I64 {
  if count == 0 {
    offset
  } else {
    advance_scalars(bytes, offset + utf8_width(bytes, offset), count - 1)
  }
}

fn[R, E : Effect] foldl_bytes(
  bytes : Bytes,
  offset : I64,
  accumulator : R,
  f : (R, Char) -> R ! E
) -> R ! E {
  if offset == Builtins.bytes_length(bytes) {
    accumulator
  } else {
    foldl_bytes(
      bytes,
      offset + utf8_width(bytes, offset),
      f(accumulator, decode_scalar(bytes, offset)),
      f
    )
  }
}

fn string_equal(left : String, right : String) -> Bool {
  Builtins.bytes_equal(Builtins.string_to_bytes(left), Builtins.string_to_bytes(right))
}

fn string_less_from(left : Bytes, left_offset : I64, right : Bytes, right_offset : I64) -> Bool {
  let left_done = left_offset == Builtins.bytes_length(left)
  let right_done = right_offset == Builtins.bytes_length(right)
  if left_done {
    if right_done {
      false
    } else {
      true
    }
  } else if right_done {
    false
  } else {
    let left_scalar = Builtins.char_to_i32(decode_scalar(left, left_offset))
    let right_scalar = Builtins.char_to_i32(decode_scalar(right, right_offset))
    if left_scalar == right_scalar {
      string_less_from(
        left,
        left_offset + utf8_width(left, left_offset),
        right,
        right_offset + utf8_width(right, right_offset)
      )
    } else {
      left_scalar < right_scalar
    }
  }
}

fn string_less(left : String, right : String) -> Bool {
  string_less_from(Builtins.string_to_bytes(left), 0, Builtins.string_to_bytes(right), 0)
}

pub offer string_impl_equal : Equal[String] = Equal::{ equal: string_equal }

pub offer string_impl_compare : Compare[String] = Compare::{
  equal_impl: string_impl_equal,
  less: string_less
}

pub offer string_impl_semigroup : Semigroup[String] = Semigroup::{ append: concat }

pub offer string_impl_monoid : Monoid[String] = Monoid::{
  semigroup_impl: string_impl_semigroup,
  empty: ""
}

// Return the number of bytes in the canonical UTF-8 representation.
pub fn byte_length(value : String) -> I64 {
  Builtins.bytes_length(Builtins.string_to_bytes(value))
}

// Count Unicode scalar values without normalizing or interpreting grapheme clusters.
pub fn scalar_count(value : String) -> I64 {
  count_scalars(Builtins.string_to_bytes(value), 0, 0)
}

// Report whether the String contains no Unicode scalar values.
pub fn is_empty(value : String) -> Bool {
  byte_length(value) == 0
}

// Encode one Char as a one-scalar String.
pub fn from_char(value : Char) -> String {
  Char.to_string(value)
}

// Concatenate exact scalar sequences without Unicode normalization.
pub fn concat(left : String, right : String) -> String {
  Builtins.bytes_to_string(
    Builtins.bytes_concat(Builtins.string_to_bytes(left), Builtins.string_to_bytes(right))
  )
}

// Read one zero-based Unicode scalar, reporting an invalid index through OutOfBound.
pub fn scalar_at(value : String, index : I64) -> Char ! OutOfBound {
  if index < 0 {
    out_of_min!()
  } else {
    let bytes = Builtins.string_to_bytes(value)
    let count = count_scalars(bytes, 0, 0)
    if index < count {
      decode_scalar(bytes, advance_scalars(bytes, 0, index))
    } else {
      out_of_max!()
    }
  }
}

// Copy a range measured in Unicode scalar values, reporting an invalid range through OutOfBound.
pub fn slice(value : String, start : I64, length : I64) -> String ! OutOfBound {
  if start < 0 {
    out_of_min!()
  } else if length < 0 {
    out_of_min!()
  } else {
    let bytes = Builtins.string_to_bytes(value)
    let count = count_scalars(bytes, 0, 0)
    if count < start {
      out_of_max!()
    } else if count - start < length {
      out_of_max!()
    } else {
      let start_offset = advance_scalars(bytes, 0, start)
      let end_offset = advance_scalars(bytes, start_offset, length)
      Builtins.bytes_to_string(Builtins.bytes_slice(bytes, start_offset, end_offset - start_offset))
    }
  }
}

// Fold Unicode scalars from left to right while preserving the callback effect.
pub fn[R, E : Effect] foldl(value : String, init : R, f : (R, Char) -> R ! E) -> R ! E {
  foldl_bytes(Builtins.string_to_bytes(value), 0, init, f)
}

// Return the canonical UTF-8 encoding in O(1) by sharing the runtime representation.
pub fn encode_utf8(value : String) -> Bytes {
  Builtins.string_to_bytes(value)
}

// Validate a byte sequence and reuse its runtime representation only when it is valid UTF-8.
pub fn decode_utf8(bytes : Bytes) -> Option[String] {
  if Builtins.bytes_is_valid_utf8(bytes) {
    some(Builtins.bytes_to_string(bytes))
  } else {
    none()
  }
}
