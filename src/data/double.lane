module Basic.Data.Double

import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ Compare }
import Basic.Trait.Num.{ Add, Sub, Mul, Div, Neg }
import Basic.Builtins.{
  double_add,
  double_sub,
  double_mul,
  double_div,
  double_neg,
  double_equal,
  double_less,
  double_inf,
  double_ninf,
  double_nan
}

pub offer double_impl_add : Add[Double] = Add::{ add: double_add }

pub offer double_impl_sub : Sub[Double] = Sub::{ sub: double_sub }

pub offer double_impl_mul : Mul[Double] = Mul::{ mul: double_mul }

pub offer double_impl_div : Div[Double] = Div::{ div: double_div }

pub offer double_impl_neg : Neg[Double] = Neg::{ neg: double_neg }

pub offer double_impl_equal : Equal[Double] = Equal::{ equal: double_equal }

pub offer double_impl_compare : Compare[Double] = Compare::{
  equal_impl: double_impl_equal,
  less: double_less
}

pub let inf : Double = double_inf

pub let ninf : Double = double_ninf

pub let nan : Double = double_nan
