module Basic.Data.Bool

import Basic.Trait.Bool.{ And, Or, Not }
import Basic.Trait.Equal.{ Equal }

pub offer bool_impl_and : And = And::{ and }

pub offer bool_impl_or : Or = Or::{ or }

pub offer bool_impl_not : Not = Not::{ not }

pub offer bool_impl_equal : Equal[Bool] = Equal::{ equal }

pub fn[E : Effect] and(a : Bool, b : () -> Bool ! E) -> Bool ! E {
  if a {
    b()
  } else {
    false
  }
}

pub fn[E : Effect] or(a : Bool, b : () -> Bool ! E) -> Bool ! E {
  if a {
    true
  } else {
    b()
  }
}

pub fn not(a : Bool) -> Bool {
  if a {
    false
  } else {
    true
  }
}

pub fn equal(a : Bool, b : Bool) -> Bool {
  if a {
    b
  } else {
    not(b)
  }
}
