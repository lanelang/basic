module Basic.Data.F32

import Basic.Data.Option.{ Option }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ PartialCompare, TotalCompare, Ordering }
import Basic.Trait.Num.{ Add, Sub, Mul, Div, Neg }
import Basic.Builtins.{
  f32_add,
  f32_sub,
  f32_mul,
  f32_div,
  f32_neg,
  f32_equal,
  f32_less,
  f32_inf,
  f32_ninf,
  f32_nan,
  i64_to_f32,
  f32_to_i64,
  f32_to_f64,
  f64_to_f32
}

pub offer f32_impl_add : Add[F32] = Add::{ add: f32_add }

pub offer f32_impl_sub : Sub[F32] = Sub::{ sub: f32_sub }

pub offer f32_impl_mul : Mul[F32] = Mul::{ mul: f32_mul }

pub offer f32_impl_div : Div[F32] = Div::{ div: f32_div }

pub offer f32_impl_neg : Neg[F32] = Neg::{ neg: f32_neg }

pub offer f32_impl_equal : Equal[F32] = Equal::{ equal: f32_equal }

pub offer f32_impl_compare : PartialCompare[F32] = PartialCompare::{
  equal_impl: f32_impl_equal,
  less: f32_less
}

pub let inf : F32 = f32_inf

pub let ninf : F32 = f32_ninf

pub let nan : F32 = f32_nan

pub fn from_i64(value : I64) -> F32 {
  i64_to_f32(value)
}

// Truncate toward zero only for finite values in [-2^63, 2^63).
pub fn to_i64(value : F32) -> Option[I64] {
  if f32_equal(value, value) {
    if f32_less(value, -9223372036854775808.0f32) {
      none()
    } else if f32_less(value, 9223372036854775808.0f32) {
      some(f32_to_i64(value))
    } else {
      none()
    }
  } else {
    none()
  }
}

// IEEE division is pure, including infinity and NaN. The generic / capability
// conservatively carries Panic because integer division can fail.
pub fn divide(a : F32, b : F32) -> F32 {
  f32_div(a, b)
}

pub fn to_f64(value : F32) -> F64 {
  f32_to_f64(value)
}

pub fn from_f64(value : F64) -> F32 {
  f64_to_f32(value)
}

// Total numeric order: all NaNs form one greatest class; signed zeros compare equal.
pub offer f32_impl_total_compare : TotalCompare[F32] = TotalCompare::{
  compare: fn(a, b) {
    if f32_equal(a, a) {
      if f32_equal(b, b) {
        if f32_equal(a, b) {
          Ordering::equal()
        } else if f32_less(a, b) {
          Ordering::less()
        } else {
          Ordering::greater()
        }
      } else {
        Ordering::less()
      }
    } else {
      if f32_equal(b, b) {
        Ordering::greater()
      } else {
        Ordering::equal()
      }
    }
  }
}
