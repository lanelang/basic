module Basic.Data.S32

import Basic.Trait.Num.{ Add, Sub, Mul, Div, Rem, Neg }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ Compare }
import Basic.Builtins.{
  s32_add,
  s32_sub,
  s32_mul,
  s32_div,
  s32_rem,
  s32_neg,
  s32_equal,
  s32_less,
  s32_to_int,
  int_to_s32
}

pub offer s32_impl_add : Add[S32] = Add::{ add: s32_add }

pub offer s32_impl_sub : Sub[S32] = Sub::{ sub: s32_sub }

pub offer s32_impl_mul : Mul[S32] = Mul::{ mul: s32_mul }

pub offer s32_impl_div : Div[S32] = Div::{ div: s32_div }

pub offer s32_impl_rem : Rem[S32] = Rem::{ rem: s32_rem }

pub offer s32_impl_neg : Neg[S32] = Neg::{ neg: s32_neg }

pub offer s32_impl_equal : Equal[S32] = Equal::{ equal: s32_equal }

pub offer s32_impl_compare : Compare[S32] = Compare::{ equal_impl: s32_impl_equal, less: s32_less }

// Sign-extend an S32 value to Int.
pub fn to_int(value : S32) -> Int {
  s32_to_int(value)
}

// Keep the low 32 bits of an Int and interpret them as signed two's complement.
pub fn from_int(value : Int) -> S32 {
  int_to_s32(value)
}
