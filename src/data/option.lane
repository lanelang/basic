module Basic.Data.Option

import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Map.{ Mappable }
import Basic.Trait.App.{ Applicative }
import Basic.Derive.Equal.{ derive_equal }
import Basic.Derive.*
import Basic.Trait.Flat.{ FlatMappable }

pub enum Option[T] {
  some(T)
  none()
}

pub offer fn[T] option_impl_equal(auto offer equal_impl : Equal[T]) -> Equal[Option[T]] {
  derive[Equal, Option[T]]()
}

pub fn[T, R, E : Effect] map(o : Option[T], f : (T) -> R ! E) -> Option[R] ! E {
  match o {
    none() => none()
    some(v) => some(f(v))
  }
}

pub fn[T, R, E : Effect] apply(a : Option[T], f : Option[(T) -> R ! E]) -> Option[R] ! E {
  match a {
    none() => none()
    some(v) =>
      match f {
        none() => none()
        some(f) => some(f(v))
      }
  }
}

pub fn[T] pure(a : T) -> Option[T] {
  some(a)
}

pub fn[T] get_or(o : Option[T], default : T) -> T {
  match o {
    none() => default
    some(v) => v
  }
}

pub fn[T, R, E : Effect] flat_map(o : Option[T], f : (T) -> Option[R] ! E) -> Option[R] ! E {
  match o {
    none() => none()
    some(v) => f(v)
  }
}

pub offer option_impl_mappable : Mappable[Option] = Mappable::{ map }

pub offer option_impl_applicative : Applicative[Option] = Applicative::{
  apply,
  pure,
  mappable_impl: option_impl_mappable
}

pub offer option_impl_flat_mappable : FlatMappable[Option] = FlatMappable::{
  applicative_impl: option_impl_applicative,
  flat_map
}

// Evaluate the fallback only when the value is absent.
pub fn[T, E : Effect] get_or_else(value : Option[T], fallback : () -> T ! E) -> T ! E {
  match value {
    some(value) => value
    none() => fallback()
  }
}

pub fn[T, E : Effect] or_else(value : Option[T], fallback : () -> Option[T] ! E) -> Option[T] ! E {
  match value {
    some(_) => value
    none() => fallback()
  }
}

pub fn[T] is_some(value : Option[T]) -> Bool {
  match value {
    some(_) => true
    none() => false
  }
}

pub fn[T] is_none(value : Option[T]) -> Bool {
  match value {
    some(_) => false
    none() => true
  }
}
