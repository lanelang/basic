module Basic.Data.Bytes

import Basic.Builtins as Builtins
import Basic.Ops.{ op_less, op_greater_eq }
import Basic.Data.Int.{ int_impl_compare }
import Basic.Eff.Bound.{ OutOfBound }

pub fn bytes_make(len : Int, init : Byte) -> Bytes ! OutOfBound {
  if len < 0 {
    out_of_min!()
  } else {
    Builtins.bytes_make(len, init)
  }
}

pub fn bytes_length(bytes : Bytes) -> Int {
  Builtins.bytes_length(bytes)
}

pub fn bytes_get(bytes : Bytes, index : Int) -> Byte ! OutOfBound {
  if index < 0 {
    out_of_min!()
  } else if index >= Builtins.bytes_length(bytes) {
    out_of_max!()
  } else {
    Builtins.bytes_get(bytes, index)
  }
}

pub fn bytes_set(bytes : Bytes, index : Int, byte : Byte) -> Bytes ! OutOfBound {
  if index < 0 {
    out_of_min!()
  } else if index >= Builtins.bytes_length(bytes) {
    out_of_max!()
  } else {
    Builtins.bytes_set(bytes, index, byte)
  }
}
