module Basic.Data.List

import Basic.Data.Tuple.{ Tuple }
import Basic.Data.Option.{ Option }
import Basic.Data.Int.{ int_impl_add, int_impl_sub, int_impl_compare, int_impl_equal }
import Basic.Eff.Bound.{ OutOfBound }
import Basic.Trait.Monoid.{ Monoid, Semigroup }
import Basic.Trait.Map.{ Mappable }
import Basic.Trait.App.{ Applicative }
import Basic.Trait.Flat.{ FlatMappable }
import Basic.Trait.Equal.{ Equal }
import Basic.Ops.{ op_equal, op_add, op_less, op_sub }

pub enum List[T] {
  empty()
  cons(T, List[T])
}

pub fn[T] equals(a : List[T], b : List[T], auto offer equal_impl : Equal[T]) -> Bool {
  match a {
    empty() =>
      match b {
        empty() => true
        _ => false
      }
    cons(x, xs) =>
      match b {
        empty() => false
        cons(y, ys) =>
          if x == y {
            equals(xs, ys)
          } else {
            false
          }
      }
  }
}

pub offer fn[T] list_impl_equal(auto offer equal : Equal[T]) -> Equal[List[T]] {
  Equal::{
    equal: fn(a, b) {
      equals(a, b)
    }
  }
}

pub fn[T] length(list : List[T]) -> Int {
  match list {
    empty() => 0
    cons(_x, xs) => length(xs) + 1
  }
}

pub fn[T] append(a : List[T], b : List[T]) -> List[T] {
  match a {
    empty() => b
    cons(x, xs) => cons(x, append(xs, b))
  }
}

pub fn[T, R, E : Effect] map(list : List[T], f : (T) -> R ! E) -> List[R] ! E {
  match list {
    empty() => empty()
    cons(x, xs) => cons(f(x), map(xs, f))
  }
}

pub offer list_impl_mappable : Mappable[List] = Mappable::{ map }

pub fn[T] elem(list : List[T], index : Int) -> T ! OutOfBound {
  if index < 0 {
    out_of_min!()
  } else if index == 0 {
    match list {
      empty() => out_of_min!()
      cons(x, _xs) => x
    }
  } else {
    match list {
      empty() => out_of_max!()
      cons(_x, xs) => elem(xs, index - 1)
    }
  }
}

pub fn[T] push_tail(list : List[T], elem : T) -> List[T] {
  match list {
    empty() => [elem]
    cons(x, xs) => cons(x, push_tail(xs, elem))
  }
}

pub fn[T] push_head(list : List[T], elem : T) -> List[T] {
  cons(elem, list)
}

pub fn[T] filter(list : List[T], pred : (T) -> Bool) -> List[T] {
  match list {
    empty() => empty()
    cons(x, xs) =>
      if pred(x) {
        cons(x, filter(xs, pred))
      } else {
        filter(xs, pred)
      }
  }
}

pub fn[T] find(list : List[T], pred : (T) -> Bool) -> Option[T] {
  match list {
    empty() => none()
    cons(x, xs) =>
      if pred(x) {
        some(x)
      } else {
        find(xs, pred)
      }
  }
}

pub fn[T] contains(list : List[T], elem : T, auto offer equal_impl : Equal[T]) -> Bool {
  match list {
    empty() => false
    cons(x, xs) =>
      if x == elem {
        true
      } else {
        contains(xs, elem, equal_impl=equal_impl)
      }
  }
}

pub fn[T] pure(x : T) -> List[T] {
  [x]
}

pub fn[T, R, E : Effect] apply(list : List[T], flist : List[(T) -> R ! E]) -> List[R] ! E {
  match flist {
    empty() => empty()
    cons(f, fs) => append(map(list, f), apply(list, fs))
  }
}

pub offer list_impl_applicative : Applicative[List] = Applicative::{
  apply,
  pure,
  mappable_impl: list_impl_mappable
}

pub fn[T, R, E : Effect] flat_map(list : List[T], f : (T) -> List[R] ! E) -> List[R] ! E {
  match list {
    empty() => empty()
    cons(x, xs) => {
      match f(x) {
        empty() => flat_map(xs, f)
        r => append(r, flat_map(xs, f))
      }
    }
  }
}

pub offer list_impl_flat_mappable : FlatMappable[List] = FlatMappable::{
  applicative_impl: list_impl_applicative,
  flat_map
}

pub offer fn[T] list_impl_monoid() -> Monoid[List[T]] {
  Monoid::{
    empty: empty(),
    semigroup_impl: Semigroup::{
      append: fn(a, b) {
        append(a, b)
      }
    }
  }
}

pub fn[T, R, E : Effect] foldr(list : List[T], init : R, f : (T, R) -> R ! E) -> R ! E {
  match list {
    empty() => init
    cons(x, xs) => f(x, foldr(xs, init, f))
  }
}

pub fn[T, R, E : Effect] foldl(list : List[T], init : R, f : (R, T) -> R ! E) -> R ! E {
  match list {
    empty() => init
    cons(x, xs) => foldl(xs, f(init, x), f)
  }
}

pub fn[T, E : Effect] all(list : List[T], pred : (T) -> Bool ! E) -> Bool ! E {
  match list {
    empty() => true
    cons(x, xs) =>
      if pred(x) {
        all(xs, pred)
      } else {
        false
      }
  }
}

pub fn[T, E : Effect] any(list : List[T], pred : (T) -> Bool ! E) -> Bool ! E {
  match list {
    empty() => false
    cons(x, xs) =>
      if pred(x) {
        true
      } else {
        any(xs, pred)
      }
  }
}

pub fn[A, B] zip(al : List[A], bl : List[B]) -> List[(A, B)] {
  match (al, bl) {
    (cons(x, xs), cons(y, ys)) => cons((x, y), zip(xs, ys))
    _ => empty()
  }
}
