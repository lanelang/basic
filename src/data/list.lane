module Basic.Data.List

import Basic.Data.Tuple.{ Tuple }
import Basic.Data.Option.{ Option }
import Basic.Data.I64.{ i64_impl_add, i64_impl_sub, i64_impl_compare, i64_impl_equal }
import Basic.Eff.Bound.{ OutOfBound }
import Basic.Trait.Monoid.{ Monoid, Semigroup }
import Basic.Trait.Map.{ Mappable }
import Basic.Trait.App.{ Applicative }
import Basic.Trait.Flat.{ FlatMappable }
import Basic.Trait.Equal.{ Equal }
import Basic.Derive.Equal.{ derive_equal, recursive_equal }
import Basic.Derive.*
import Basic.Ops.{ op_add, op_sub, op_equal, op_less }

pub enum List[T] {
  empty()
  cons(T, List[T])
}

pub offer fn[T] list_impl_equal(auto offer equal : Equal[T]) -> Equal[List[T]] {
  offer recursive_list_equal : Equal[List[T]] = recursive_equal.defer(
    fn() {
      list_impl_equal()
    }
  )
  derive[Equal, List[T]]()
}

fn[T] length_from(list : List[T], count : I64) -> I64 {
  match list {
    empty() => count
    cons(_, rest) => length_from(rest, count + 1)
  }
}

// Linear time, constant call-stack depth.
pub fn[T] length(list : List[T]) -> I64 {
  length_from(list, 0)
}

// Reverse the first list onto the second in linear time.
pub fn[T] reverse_append(list : List[T], tail : List[T]) -> List[T] {
  match list {
    empty() => tail
    cons(value, rest) => reverse_append(rest, cons(value, tail))
  }
}

pub fn[T] reverse(list : List[T]) -> List[T] {
  reverse_append(list, [])
}

// Linear in the first list; shares the second list.
pub fn[T] append(a : List[T], b : List[T]) -> List[T] {
  reverse_append(reverse(a), b)
}

fn[T, R, E : Effect] map_reverse(list : List[T], f : (T) -> R ! E, acc : List[R]) -> List[R] ! E {
  match list {
    empty() => acc
    cons(x, xs) => map_reverse(xs, f, cons(f(x), acc))
  }
}

// Callbacks run left to right, once per element.
pub fn[T, R, E : Effect] map(list : List[T], f : (T) -> R ! E) -> List[R] ! E {
  reverse(map_reverse(list, f, []))
}

pub offer list_impl_mappable : Mappable[List] = Mappable::{ map }

pub fn[T] elem(list : List[T], index : I64) -> T ! OutOfBound {
  if index < 0 {
    out_of_min!()
  } else if index == 0 {
    match list {
      empty() => out_of_max!()
      cons(x, _xs) => x
    }
  } else {
    match list {
      empty() => out_of_max!()
      cons(_x, xs) => elem(xs, index - 1)
    }
  }
}

// Linear in list length. Use cons/reverse for repeated construction.
pub fn[T] push_tail(list : List[T], elem : T) -> List[T] {
  append(list, [elem])
}

pub fn[T] get(list : List[T], index : I64) -> Option[T] {
  if index < 0 {
    none()
  } else {
    match list {
      empty() => none()
      cons(x, xs) =>
        if index == 0 {
          some(x)
        } else {
          get(xs, index - 1)
        }
    }
  }
}

pub fn[T] push_head(list : List[T], elem : T) -> List[T] {
  cons(elem, list)
}

fn[T, E : Effect] filter_reverse(
  list : List[T],
  pred : (T) -> Bool ! E,
  acc : List[T]
) -> List[T] ! E {
  match list {
    empty() => acc
    cons(x, xs) => filter_reverse(
      xs,
      pred,
      if pred(x) {
        cons(x, acc)
      } else {
        acc
      }
    )
  }
}

pub fn[T, E : Effect] filter(list : List[T], pred : (T) -> Bool ! E) -> List[T] ! E {
  reverse(filter_reverse(list, pred, []))
}

// Stop at the first match; later callbacks are not invoked.
pub fn[T, E : Effect] find(list : List[T], pred : (T) -> Bool ! E) -> Option[T] ! E {
  match list {
    empty() => none()
    cons(x, xs) =>
      if pred(x) {
        some(x)
      } else {
        find(xs, pred)
      }
  }
}

pub fn[T] contains(list : List[T], elem : T, auto offer equal_impl : Equal[T]) -> Bool {
  match list {
    empty() => false
    cons(x, xs) =>
      if x == elem {
        true
      } else {
        contains(xs, elem, equal_impl=equal_impl)
      }
  }
}

pub fn[T] pure(x : T) -> List[T] {
  [x]
}

fn[T, R, E : Effect] apply_reverse(
  list : List[T],
  functions : List[(T) -> R ! E],
  acc : List[R]
) -> List[R] ! E {
  match functions {
    empty() => acc
    cons(f, fs) => apply_reverse(list, fs, map_reverse(list, f, acc))
  }
}

// Functions run in order; each visits values left to right.
pub fn[T, R, E : Effect] apply(list : List[T], flist : List[(T) -> R ! E]) -> List[R] ! E {
  reverse(apply_reverse(list, flist, []))
}

pub offer list_impl_applicative : Applicative[List] = Applicative::{
  apply,
  pure,
  mappable_impl: list_impl_mappable
}

fn[T, R, E : Effect] flat_map_reverse(
  list : List[T],
  f : (T) -> List[R] ! E,
  acc : List[R]
) -> List[R] ! E {
  match list {
    empty() => acc
    cons(x, xs) => flat_map_reverse(xs, f, reverse_append(f(x), acc))
  }
}

pub fn[T, R, E : Effect] flat_map(list : List[T], f : (T) -> List[R] ! E) -> List[R] ! E {
  reverse(flat_map_reverse(list, f, []))
}

pub offer list_impl_flat_mappable : FlatMappable[List] = FlatMappable::{
  applicative_impl: list_impl_applicative,
  flat_map
}

pub offer fn[T] list_impl_semigroup() -> Semigroup[List[T]] {
  Semigroup::{
    append: fn(a, b) {
      append(a, b)
    }
  }
}

pub offer fn[T] list_impl_monoid() -> Monoid[List[T]] {
  Monoid::{ empty: empty(), semigroup_impl: list_impl_semigroup[T]() }
}

// Strict right fold: callbacks run from the last element to the first.
pub fn[T, R, E : Effect] foldr(list : List[T], init : R, f : (T, R) -> R ! E) -> R ! E {
  foldl(
    reverse(list),
    init,
    fn(acc, item) {
      f(item, acc)
    }
  )
}

pub fn[T, R, E : Effect] foldl(list : List[T], init : R, f : (R, T) -> R ! E) -> R ! E {
  match list {
    empty() => init
    cons(x, xs) => foldl(xs, f(init, x), f)
  }
}

pub fn[T, E : Effect] all(list : List[T], pred : (T) -> Bool ! E) -> Bool ! E {
  match list {
    empty() => true
    cons(x, xs) =>
      if pred(x) {
        all(xs, pred)
      } else {
        false
      }
  }
}

pub fn[T, E : Effect] any(list : List[T], pred : (T) -> Bool ! E) -> Bool ! E {
  match list {
    empty() => false
    cons(x, xs) =>
      if pred(x) {
        true
      } else {
        any(xs, pred)
      }
  }
}

fn[A, B] zip_reverse(al : List[A], bl : List[B], acc : List[(A, B)]) -> List[(A, B)] {
  match (al, bl) {
    (cons(x, xs), cons(y, ys)) => zip_reverse(xs, ys, cons((x, y), acc))
    _ => acc
  }
}

// Stop at the shorter input.
pub fn[A, B] zip(al : List[A], bl : List[B]) -> List[(A, B)] {
  reverse(zip_reverse(al, bl, []))
}
