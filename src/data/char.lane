module Basic.Data.Char

import Basic.Builtins as Builtins
import Basic.Data.Option.{ Option }
import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ Compare }

fn char_equal(left : Char, right : Char) -> Bool {
  Builtins.i32_equal(Builtins.char_to_i32(left), Builtins.char_to_i32(right))
}

fn char_less(left : Char, right : Char) -> Bool {
  Builtins.i32_less(Builtins.char_to_i32(left), Builtins.char_to_i32(right))
}

pub offer char_impl_equal : Equal[Char] = Equal::{ equal: char_equal }

pub offer char_impl_compare : Compare[Char] = Compare::{
  equal_impl: char_impl_equal,
  less: char_less
}

// Return the Unicode scalar represented by value, rejecting values outside the scalar range and surrogates.
pub fn from_i64(value : I64) -> Option[Char] {
  if Builtins.i64_less(value, 0) {
    none()
  } else if Builtins.i64_less(1114111, value) {
    none()
  } else if Builtins.i64_less(value, 55296) {
    some(Builtins.i32_to_char(Builtins.i64_to_i32(value)))
  } else if Builtins.i64_less(value, 57344) {
    none()
  } else {
    some(Builtins.i32_to_char(Builtins.i64_to_i32(value)))
  }
}

// Return the Unicode scalar value as an I64.
pub fn to_i64(value : Char) -> I64 {
  Builtins.i32_to_i64(Builtins.char_to_i32(value))
}

fn one_byte(first : I64) -> String {
  Builtins.bytes_to_string(Builtins.bytes_make(1, Builtins.i64_to_byte(first)))
}

fn two_bytes(first : I64, second : I64) -> String {
  let bytes = Builtins.bytes_make(2, Builtins.i64_to_byte(first))
  Builtins.bytes_to_string(Builtins.bytes_set(bytes, 1, Builtins.i64_to_byte(second)))
}

fn three_bytes(first : I64, second : I64, third : I64) -> String {
  let bytes = Builtins.bytes_make(3, Builtins.i64_to_byte(first))
  let bytes = Builtins.bytes_set(bytes, 1, Builtins.i64_to_byte(second))
  Builtins.bytes_to_string(Builtins.bytes_set(bytes, 2, Builtins.i64_to_byte(third)))
}

fn four_bytes(first : I64, second : I64, third : I64, fourth : I64) -> String {
  let bytes = Builtins.bytes_make(4, Builtins.i64_to_byte(first))
  let bytes = Builtins.bytes_set(bytes, 1, Builtins.i64_to_byte(second))
  let bytes = Builtins.bytes_set(bytes, 2, Builtins.i64_to_byte(third))
  Builtins.bytes_to_string(Builtins.bytes_set(bytes, 3, Builtins.i64_to_byte(fourth)))
}

// Encode one Unicode scalar as a one-scalar UTF-8 String.
pub fn to_string(value : Char) -> String {
  let scalar = to_i64(value)
  if Builtins.i64_less(scalar, 128) {
    one_byte(scalar)
  } else if Builtins.i64_less(scalar, 2048) {
    two_bytes(
      Builtins.i64_add(192, Builtins.i64_div(scalar, 64)),
      Builtins.i64_add(128, Builtins.i64_rem(scalar, 64))
    )
  } else if Builtins.i64_less(scalar, 65536) {
    three_bytes(
      Builtins.i64_add(224, Builtins.i64_div(scalar, 4096)),
      Builtins.i64_add(128, Builtins.i64_rem(Builtins.i64_div(scalar, 64), 64)),
      Builtins.i64_add(128, Builtins.i64_rem(scalar, 64))
    )
  } else {
    four_bytes(
      Builtins.i64_add(240, Builtins.i64_div(scalar, 262144)),
      Builtins.i64_add(128, Builtins.i64_rem(Builtins.i64_div(scalar, 4096), 64)),
      Builtins.i64_add(128, Builtins.i64_rem(Builtins.i64_div(scalar, 64), 64)),
      Builtins.i64_add(128, Builtins.i64_rem(scalar, 64))
    )
  }
}
