module Basic.Eff.Writer

import Basic.Trait.Monoid.{ Monoid, Semigroup }
import Basic.Data.List.{ List, reverse }

pub effect Writer[T] {
  tell(T) -> Unit
}

pub struct WriterResult[A, W] {
  value : A
  log : W
}

pub fn[A, W, E : Effect] run_writer(
  action : () -> A ! { Writer[W], E },
  auto monoid_impl : Monoid[W]
) -> WriterResult[A, W] ! { E, Panic } {
  let first : WriterStep[A, W, E] = handle action() with {
    tell(message, resume) => WriterStep[A, W, E]::more(
      message,
      fn() {
        resume(())
      }
    )
  } final value {
    WriterStep[A, W, E]::done(value)
  }
  let collected = collect(first, [])
  WriterResult[A, W]::{
    value: collected.value,
    log: merge_all(reverse(collected.log), monoid_impl)
  }
}

// Return to the driver before resuming the action, so every tell uses bounded
// handler stack space, including on the interpreter backend.
enum WriterStep[A, W, E : Effect] {
  done(A)
  more(W, () -> WriterStep[A, W, E] ! { E, Panic })
}

fn[A, W, E : Effect] collect(
  step : WriterStep[A, W, E],
  log : List[W]
) -> WriterResult[A, List[W]] ! { E, Panic } {
  match step {
    done(value) => WriterResult[A, List[W]]::{ value, log }
    more(message, next) => collect(next(), cons(message, log))
  }
}

// Reassociate only the pure, associative monoid operation. Message order and
// action effects are preserved; strings avoid repeatedly copying the full log.
fn[W] merge_pairs(values : List[W], append : Semigroup[W], acc : List[W]) -> List[W] {
  match values {
    empty() => reverse(acc)
    cons(a, empty()) => reverse(cons(a, acc))
    cons(a, cons(b, rest)) => merge_pairs(rest, append, cons(append.append(a, b), acc))
  }
}

fn[W] merge_all(values : List[W], monoid : Monoid[W]) -> W {
  match values {
    empty() => monoid.empty
    cons(value, empty()) => value
    _ => merge_all(merge_pairs(values, monoid.semigroup_impl, []), monoid)
  }
}
