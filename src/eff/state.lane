module Basic.Eff.State

pub struct StateResult[R, S] {
  value : R
  state : S
}

pub effect State[S] {
  get() -> S
  put(S) -> Unit
}

pub fn[R, S, E : Effect] run_state(
  action : () -> R ! { E, State[S] },
  init : S
) -> StateResult[R, S] ! { E, Panic } {
  let transform = handle action() with {
    get(resume) => fn(state) {
      resume(state)(state)
    }
    put(next, resume) => fn(_state) {
      resume(())(next)
    }
  } final value {
    fn(state : S) -> StateResult[R, S] ! { E, Panic } {
      StateResult::{ value, state }
    }
  }
  transform(init)
}
