module Basic.Summon

pub fn[T] summon(auto x : T) -> T {
  x
}

pub fn[T] summon_on(auto x : T) -> () -> T {
  fn() {
    x
  }
}

// `summon_via` uses local structural inference. A nominal expected type such as
// `Equal[Option[Char]]` retains its constructor head, so the three generic
// arguments can be inferred. A transparent capability alias such as `Debug[T]`
// reduces to its function representation first; reconstructing `Debug` would
// require non-unique higher-order type-lambda synthesis. Such call sites must
// therefore pass the generic arguments explicitly.
pub fn[Evid : [Type] -> Type, T1 : [Type] -> Type, T2 : Type] summon_via(
  auto provider : [T](Evid[T]) -> Evid[T1[T]],
  auto base : Evid[T2]
) -> Evid[T1[T2]] {
  provider(base)
}

pub fn[Evid : [Type] -> Type, F : [Type, Type] -> Type, A : Type, B : Type] summon_via2(
  auto provider : [X, Y](Evid[X], Evid[Y]) -> Evid[F[X, Y]],
  auto base1 : Evid[A],
  auto base2 : Evid[B]
) -> Evid[F[A, B]] {
  provider(base1, base2)
}
