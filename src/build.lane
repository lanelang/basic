module Basic.Build

pub import Basic.Build.Plan.{
  Export,
  Project,
  Configuration,
  default_configuration,
  SourceModule,
  CompileStep,
  BuildPlan,
  PlanError,
  plan
}
import Basic.Build.Inspection.{ decode as decode_inspection }
import Basic.Builtins.{ bytes_length, bytes_get, byte_to_i64, i64_equal, i64_less, string_to_bytes }
import Basic.Data.List.{ List, append as append_list, map }
import Basic.Data.Option.{ Option }
import Basic.Data.Result.{ Result }
import Basic.Data.String.{ concat, decode_utf8 }
import Basic.Eff.Exn.{ Exception, throw }
import Basic.System.Process.{
  Command,
  CommandOutput,
  ExitStatus,
  Process,
  run_command,
  error_message as process_error_message
}
import Basic.System.FileSystem.{
  FileSystem,
  ensure_directory_exists,
  error_message as file_system_error_message
}

fn command(configuration : Configuration, arguments : List[String]) -> Command {
  Command::{
    executable: configuration.compiler,
    arguments,
    working_directory: some(configuration.project_root),
    environment: [],
    inherit_environment: true,
    stdin: string_to_bytes("")
  }
}

fn diagnostic_text(bytes : Bytes) -> String {
  match decode_utf8(bytes) {
    some(text) => text
    none() => "Lane command emitted non-UTF-8 output"
  }
}

fn command_failure(output : CommandOutput) -> String {
  if i64_less(0, bytes_length(output.stderr)) {
    diagnostic_text(output.stderr)
  } else if i64_less(0, bytes_length(output.stdout)) {
    diagnostic_text(output.stdout)
  } else {
    "Lane command failed"
  }
}

fn run_checked(value : Command) -> CommandOutput ! { Process, Exception } {
  match run_command(value) {
    err(error) => throw[CommandOutput](process_error_message(error))
    ok(output) =>
      match output.status {
        exited(0i32) => output
        _ => throw[CommandOutput](command_failure(output))
      }
  }
}

fn inspect_source(
  path : String,
  configuration : Configuration
) -> SourceModule ! { Process, Exception } {
  let output = run_checked(command(configuration, ["inspect", path]))
  match decode_utf8(output.stdout) {
    none() => throw[SourceModule](concat("lane inspect emitted non-UTF-8 output for ", path))
    some(text) =>
      match decode_inspection(text) {
        none() => throw[SourceModule](
          concat("lane inspect returned an invalid source inspection for ", path)
        )
        some(inspection) => SourceModule::{
          path,
          module_name: inspection.module_name,
          imports: inspection.imports
        }
      }
  }
}

fn artifact(directory : String, module_name : String, extension : String) -> String {
  concat(concat(concat(concat(directory, "/"), module_name), "."), extension)
}

fn interface_arguments(imports : List[String], directory : String) -> List[String] {
  match imports {
    empty() => []
    cons(name, rest) => cons(
      "-i",
      cons(artifact(directory, name, "lmi"), interface_arguments(rest, directory))
    )
  }
}

fn compile_steps(
  steps : List[CompileStep],
  configuration : Configuration,
  directory : String
) -> Unit ! { Process, Exception } {
  match steps {
    empty() => ()
    cons(step, rest) => {
      let name = step.source.module_name
      let arguments =
        append_list(
          [
            "compile",
            "-I",
            artifact(directory, name, "lmi"),
            "-o",
            artifact(directory, name, "lmo")
          ],
          append_list(interface_arguments(step.interfaces, directory), [step.source.path])
        )
      let _output = run_checked(command(configuration, arguments))
      compile_steps(rest, configuration, directory)
    }
  }
}

fn export_arguments(exports : List[Export]) -> List[String] {
  match exports {
    empty() => []
    cons(value, rest) => cons(
      "--export",
      cons(
        concat(
          concat(concat(concat(value.module_name, "."), value.value_name), ":"),
          value.wasm_name
        ),
        export_arguments(rest)
      )
    )
  }
}

fn rooted(root : String, path : String) -> String {
  let bytes = string_to_bytes(path)
  if i64_equal(bytes_length(bytes), 0) {
    root
  } else if i64_equal(byte_to_i64(bytes_get(bytes, 0)), 47) {
    path
  } else {
    concat(concat(root, "/"), path)
  }
}

pub fn plan_error_message(error : PlanError) -> String {
  match error {
    duplicate_module(name) => concat("duplicate source module: ", name)
    missing_module(name) => concat("missing source module: ", name)
    dependency_cycle(name) => concat("cyclic source dependency through: ", name)
  }
}

// Execute only after the entire graph has passed pure planning.
pub fn execute(plan : BuildPlan) -> Unit ! { Process, FileSystem, Exception } {
  let project = plan.project
  match ensure_directory_exists(rooted(plan.configuration.project_root, project.artifact_directory)) {
    ok(_) => ()
    err(error) => throw[Unit](file_system_error_message(error))
  }
  compile_steps(plan.steps, plan.configuration, project.artifact_directory)
  let objects = map[CompileStep, String, {}](
    plan.steps,
    fn(step) {
      artifact(project.artifact_directory, step.source.module_name, "lmo")
    }
  )
  let arguments =
    append_list(
      ["link", "-o", project.output],
      append_list(export_arguments(project.exports), objects)
    )
  let _output = run_checked(command(plan.configuration, arguments))
  ()
}

pub fn build(
  project : Project,
  configuration : Configuration
) -> Unit ! { Process, FileSystem, Exception } {
  let sources = map[String, SourceModule, { Process, Exception }](
    project.sources,
    fn(path) {
      inspect_source(path, configuration)
    }
  )
  match plan(project, configuration, sources) {
    err(error) => throw[Unit](plan_error_message(error))
    ok(plan) => execute(plan)
  }
}
