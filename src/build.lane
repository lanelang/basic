module Basic.Build

import Basic.Build.Inspection.{ SourceInspection, decode as decode_inspection }
import Basic.Builtins.{ bytes_length, bytes_to_string, bytes_equal, string_to_bytes }
import Basic.Data.I64.{ i64_impl_compare }
import Basic.Data.List.{ List, append as append_list }
import Basic.Data.Option.{ Option }
import Basic.Data.String.{ concat }
import Basic.Data.Void.{ Void, absurd }
import Basic.System.Process.{
  Command,
  CommandOutput,
  CommandResult,
  Process,
  run_command as execute_command
}
import Basic.Ops.{ op_greater }

pub struct Export {
  module_name : String
  value_name : String
  wasm_name : String
}

pub struct Project {
  sources : List[String]
  exports : List[Export]
  output : String
  artifact_prefix : String
}

pub enum BuildError {
  command_failed(Command, CommandOutput)
  invalid_source_inspection(String)
  duplicate_source_module(String)
  missing_source_module(String)
  cyclic_source_dependency(String)
}

pub effect BuildFailure {
  fail(BuildError) -> Void
}

struct SourceModule {
  path : String
  module_name : String
  imports : List[String]
}

struct CompilationState {
  built : List[String]
  objects : List[String]
}

fn[T] fail(error : BuildError) -> T ! BuildFailure {
  absurd(fail!(error))
}

fn string_equal(left : String, right : String) -> Bool {
  bytes_equal(string_to_bytes(left), string_to_bytes(right))
}

fn contains_string(values : List[String], value : String) -> Bool {
  match values {
    empty() => false
    cons(head, tail) =>
      if string_equal(head, value) {
        true
      } else {
        contains_string(tail, value)
      }
  }
}

fn command_failure(output : CommandOutput) -> String {
  let stderr = bytes_to_string(output.stderr)
  if bytes_length(output.stderr) > 0 {
    stderr
  } else if bytes_length(output.stdout) > 0 {
    bytes_to_string(output.stdout)
  } else {
    "Lane command failed"
  }
}

pub fn build_error_message(error : BuildError) -> String {
  match error {
    command_failed(_command, output) => command_failure(output)
    invalid_source_inspection(path) => concat(
      concat("lane inspect returned an invalid source inspection for `", path),
      "`"
    )
    duplicate_source_module(module_name) => concat(
      concat("duplicate source module `", module_name),
      "`"
    )
    missing_source_module(module_name) => concat(
      concat("missing source module `", module_name),
      "`"
    )
    cyclic_source_dependency(module_name) => concat(
      concat("cyclic source dependency through `", module_name),
      "`"
    )
  }
}

fn run_lane(arguments : List[String]) -> CommandOutput ! { Process, BuildFailure } {
  let command = Command::{
    executable: "lane",
    arguments,
    working_directory: none(),
    environment: [],
    inherit_environment: true,
    stdin: string_to_bytes("")
  }
  let output = execute_command(command)
  match output.result {
    exited(0i32) => output
    _ => fail[CommandOutput](command_failed(command, output))
  }
}

fn inspect_source(path : String) -> SourceModule ! { Process, BuildFailure } {
  let output = run_lane(["inspect", path])
  match decode_inspection(bytes_to_string(output.stdout)) {
    none() => fail[SourceModule](invalid_source_inspection(path))
    some(inspection) => SourceModule::{
      path,
      module_name: inspection.module_name,
      imports: inspection.imports
    }
  }
}

fn inspect_sources(paths : List[String]) -> List[SourceModule] ! { Process, BuildFailure } {
  match paths {
    empty() => []
    cons(path, rest) => cons(inspect_source(path), inspect_sources(rest))
  }
}

fn find_source(sources : List[SourceModule], module_name : String) -> Option[SourceModule] {
  match sources {
    empty() => none()
    cons(source, rest) =>
      if string_equal(source.module_name, module_name) {
        some(source)
      } else {
        find_source(rest, module_name)
      }
  }
}

fn ensure_unique_modules(sources : List[SourceModule], seen : List[String]) -> Unit ! BuildFailure {
  match sources {
    empty() => ()
    cons(source, rest) => {
      if contains_string(seen, source.module_name) {
        fail[Unit](duplicate_source_module(source.module_name))
      } else {
        ensure_unique_modules(rest, cons(source.module_name, seen))
      }
    }
  }
}

fn interface_path(prefix : String, module_name : String) -> String {
  concat(concat(prefix, module_name), ".lmi")
}

fn object_path(prefix : String, module_name : String) -> String {
  concat(concat(prefix, module_name), ".lmo")
}

fn interface_arguments(imports : List[String], prefix : String) -> List[String] {
  match imports {
    empty() => []
    cons(import_, rest) => cons(
      "-i",
      cons(interface_path(prefix, import_), interface_arguments(rest, prefix))
    )
  }
}

fn compile_imports(
  imports : List[String],
  sources : List[SourceModule],
  prefix : String,
  visiting : List[String],
  state : CompilationState
) -> CompilationState ! { Process, BuildFailure } {
  match imports {
    empty() => state
    cons(import_, rest) => {
      let dependency = match find_source(sources, import_) {
        none() => fail[SourceModule](missing_source_module(import_))
        some(source) => source
      }
      let state = compile_source(dependency, sources, prefix, visiting, state)
      compile_imports(rest, sources, prefix, visiting, state)
    }
  }
}

fn compile_source(
  source : SourceModule,
  sources : List[SourceModule],
  prefix : String,
  visiting : List[String],
  state : CompilationState
) -> CompilationState ! { Process, BuildFailure } {
  if contains_string(state.built, source.module_name) {
    state
  } else if contains_string(visiting, source.module_name) {
    fail[CompilationState](cyclic_source_dependency(source.module_name))
  } else {
    let state =
      compile_imports(source.imports, sources, prefix, cons(source.module_name, visiting), state)
    let interface = interface_path(prefix, source.module_name)
    let object = object_path(prefix, source.module_name)
    let arguments =
      append_list(
        ["compile", "-I", interface, "-o", object],
        append_list(interface_arguments(state.built, prefix), [source.path])
      )
    let _output = run_lane(arguments)
    CompilationState::{
      built: cons(source.module_name, state.built),
      objects: cons(object, state.objects)
    }
  }
}

fn compile_sources(
  remaining : List[SourceModule],
  sources : List[SourceModule],
  prefix : String,
  state : CompilationState
) -> CompilationState ! { Process, BuildFailure } {
  match remaining {
    empty() => state
    cons(source, rest) => {
      let state = compile_source(source, sources, prefix, [], state)
      compile_sources(rest, sources, prefix, state)
    }
  }
}

fn export_arguments(exports : List[Export]) -> List[String] {
  match exports {
    empty() => []
    cons(export_, rest) => cons(
      "--export",
      cons(
        concat(
          concat(concat(concat(export_.module_name, "."), export_.value_name), ":"),
          export_.wasm_name
        ),
        export_arguments(rest)
      )
    )
  }
}

pub fn build(project : Project) -> Unit ! { Process, BuildFailure } {
  let sources = inspect_sources(project.sources)
  ensure_unique_modules(sources, [])
  let state = compile_sources(
    sources,
    sources,
    project.artifact_prefix,
    CompilationState::{ built: [], objects: [] }
  )
  let arguments =
    append_list(
      ["link", "-o", project.output],
      append_list(export_arguments(project.exports), state.objects)
    )
  let _output = run_lane(arguments)
  ()
}
