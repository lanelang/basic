module Basic.Derive.Debug

import Basic.Trait.Debug.{ Debug, Document }
import Basic.Data.Void.{ Void, absurd }
import Basic.Trait.Derive.{ Product, Sum, Deriver, Recursive, FieldInfo, VariantInfo, TypeInfo }
import Basic.Trait.Iso.{ Iso }

pub offer derive_debug : Deriver[Debug] = Deriver::{
  unit: show_unit,
  product: show_product,
  void: show_void,
  sum: show_sum,
  field: show_field,
  variant: show_variant,
  record: show_record,
  enumeration: show_enumeration
}

fn show_unit() -> Debug[Unit] {
  Debug::{
    format: fn(_u) {
      Document::empty()
    }
  }
}

fn show_void() -> Debug[Void] {
  Debug::{
    format: fn(value) {
      absurd(value)
    }
  }
}

fn[A, B] show_product(a : Debug[A], b : Debug[B]) -> Debug[Product[A, B]] {
  Debug::{
    format: fn(value) {
      let head = a.format(value.head)
      let tail = b.format(value.tail)
      match tail {
        empty() => head
        _ => Document::append(head, Document::append(Document::text(", "), tail))
      }
    }
  }
}

fn[A, B] show_sum(a : Debug[A], b : Debug[B]) -> Debug[Sum[A, B]] {
  Debug::{
    format: fn(value) {
      match value {
        here(x) => a.format(x)
        there(x) => b.format(x)
      }
    }
  }
}

fn[A] show_field(info : FieldInfo, a : Debug[A]) -> Debug[A] {
  Debug::{
    format: fn(value) {
      Document::append(
        Document::text(info.name),
        Document::append(Document::text(": "), a.format(value))
      )
    }
  }
}

fn[A] show_variant(info : VariantInfo, a : Debug[A]) -> Debug[A] {
  Debug::{
    format: fn(value) {
      Document::append(
        Document::text(info.name),
        Document::append(
          Document::text("("),
          Document::append(a.format(value), Document::text(")"))
        )
      )
    }
  }
}

fn[T, R] show_record(info : TypeInfo, iso : Iso[T, R], representation : Debug[R]) -> Debug[T] {
  Debug::{
    format: fn(value) {
      Document::append(
        Document::text(info.name),
        Document::append(
          Document::text("::{ "),
          Document::append(representation.format(iso.to(value)), Document::text(" }"))
        )
      )
    }
  }
}

fn[T, R] show_enumeration(info : TypeInfo, iso : Iso[T, R], representation : Debug[R]) -> Debug[T] {
  Debug::{
    format: fn(value) {
      Document::append(
        Document::text(info.name),
        Document::append(Document::text("::"), representation.format(iso.to(value)))
      )
    }
  }
}

pub let recursive_debug : Recursive[Debug] = Recursive::{
  defer: fn[T](get_debug) {
    Debug::{
      format: fn(value) {
        get_debug().format(value)
      }
    }
  }
}
