module Basic.Trait.Ops

import Basic.Trait.Equal.{ Equal }
import Basic.Trait.Compare.{ Compare }
import Basic.Data.Bool.{ bool_not_ops }
import Basic.Data.Bool.{ bool_or_ops }
import Basic.Trait.Bool.{ And, Or, Not }
import Basic.Trait.Num.{ Add, Sub, Mul, Div, Rem, Neg }

pub fn[T] op_add(a : T, b : T, auto op : Add[T]) -> T {
  op.add(a, b)
}

pub fn[T] op_sub(a : T, b : T, auto op : Sub[T]) -> T {
  op.sub(a, b)
}

pub fn[T] op_mul(a : T, b : T, auto op : Mul[T]) -> T {
  op.mul(a, b)
}

pub fn[T] op_div(a : T, b : T, auto op : Div[T]) -> T {
  op.div(a, b)
}

pub fn[T] op_rem(a : T, b : T, auto op : Rem[T]) -> T {
  op.rem(a, b)
}

pub fn[T] op_neg(value : T, auto op : Neg[T]) -> T {
  op.neg(value)
}

pub fn[T] op_equal(a : T, b : T, auto op : Equal[T]) -> Bool {
  op.equal(a, b)
}

pub fn[T] op_not_equal(a : T, b : T, auto op : Equal[T]) -> Bool {
  !op.equal(a, b)
}

pub fn op_and(a : Bool, b : () -> Bool, auto op : And) -> Bool {
  op.and(a, b)
}

pub fn op_or(a : Bool, b : () -> Bool, auto op : Or) -> Bool {
  op.or(a, b)
}

pub fn op_not(value : Bool, auto op : Not) -> Bool {
  op.not(value)
}

pub fn[T] op_less(a : T, b : T, auto op : Compare[T]) -> Bool {
  op.less(a, b)
}

pub fn[T] op_less_eq(a : T, b : T, auto op : Compare[T]) -> Bool {
  op.less(a, b) || op.equal_impl.equal(a, b)
}

pub fn[T] op_greater(a : T, b : T, auto op : Compare[T]) -> Bool {
  op.less(b, a)
}

pub fn[T] op_greater_eq(a : T, b : T, auto op : Compare[T]) -> Bool {
  op.less(b, a) || op.equal_impl.equal(a, b)
}
