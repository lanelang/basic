module Basic.Trait.Num

pub struct Add[T] {
  add : (T, T) -> T
}

pub struct Sub[T] {
  sub : (T, T) -> T
}

pub struct Mul[T] {
  mul : (T, T) -> T
}

pub struct Div[T] {
  div : (T, T) -> T ! Panic
}

pub struct Rem[T] {
  rem : (T, T) -> T ! Panic
}

pub struct Neg[T] {
  neg : (T) -> T
}

// Integer division/remainder failures, recoverable through checked operations.
pub enum ArithmeticError {
  zero_divisor()
  overflow()
}
