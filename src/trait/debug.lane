module Basic.Trait.Debug

import Basic.Builtins.{ bytes_concat, bytes_to_string, string_to_bytes }

// Empty is a structural terminator, distinct from a value rendering as "".
pub enum Document {
  empty()
  text(String)
  append(Document, Document)
}

pub struct Debug[T] {
  format : (T) -> Document
}

enum Pending {
  done()
  next(Document, Pending)
}

enum Fragments {
  end()
  fragment(Bytes, Fragments)
}

fn flatten(document : Document, pending : Pending, fragments : Fragments) -> Fragments {
  match document {
    append(left, right) => flatten(left, next(right, pending), fragments)
    _ => {
      let fragments = match document {
        text(value) => fragment(string_to_bytes(value), fragments)
        _ => fragments
      }
      match pending {
        done() => fragments
        next(value, rest) => flatten(value, rest, fragments)
      }
    }
  }
}

fn reverse_fragments(values : Fragments, acc : Fragments) -> Fragments {
  match values {
    end() => acc
    fragment(value, rest) => reverse_fragments(rest, fragment(value, acc))
  }
}

fn merge_pairs(values : Fragments, acc : Fragments) -> Fragments {
  match values {
    end() => reverse_fragments(acc, end())
    fragment(a, end()) => reverse_fragments(fragment(a, acc), end())
    fragment(a, fragment(b, rest)) => merge_pairs(rest, fragment(bytes_concat(a, b), acc))
  }
}

fn merge_all(values : Fragments) -> String {
  match values {
    end() => ""
    fragment(value, end()) => bytes_to_string(value)
    _ => merge_all(merge_pairs(values, end()))
  }
}

// Balanced merging bounds copying by O(bytes * log(fragments)), even for a
// deeply skewed document. Traversal uses an explicit stack and tail recursion.
pub fn render(document : Document) -> String {
  merge_all(reverse_fragments(flatten(document, done(), end()), end()))
}

pub fn[T] from_formatter(format : (T) -> String) -> Debug[T] {
  Debug::{
    format: fn(value) {
      Document::text(format(value))
    }
  }
}

pub fn[T] debug(value : T, auto debug_impl : Debug[T]) -> String {
  render(debug_impl.format(value))
}
