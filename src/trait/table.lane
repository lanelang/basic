module Basic.Trait.Table

import Basic.Data.Option.{ Option }
import Basic.Trait.Equal.{ Equal }

pub struct Table[T] {
  type K
  type V
  key_equal_impl : Equal[K]
  empty : () -> T
  set : (T, K, V) -> T
  get : (T, K) -> Option[V]
  del : (T, K) -> T
  // from_list : TODO:
  // to_list : TODO:
}
