module Basic.Build.Host

import Basic.Data.Void.{ absurd }
import Basic.Eff.Exn.{ Exception, message as exception_message }
import Basic.Io.{ panic }
import Basic.System.FileSystem.{ FileSystem, run_file_system }
import Basic.System.Process.{ Process, run_process }

pub fn run(action : () -> Unit ! { Process, FileSystem, Exception }) -> Unit ! { Io, Panic } {
  let hosted = run_file_system(run_process(action))
  handle hosted() with {
    raise[R](error, _resume) => absurd(panic(exception_message(error)))
  } final _value {
    ()
  }
}
