module Basic.Builtins

// if overflow, return the overflowed value
pub let i64_add : (I64, I64) -> I64 = builtin("%i64_add")

// if overflow, return the overflowed value
pub let i64_sub : (I64, I64) -> I64 = builtin("%i64_sub")

// if overflow, return the overflowed value
pub let i64_mul : (I64, I64) -> I64 = builtin("%i64_mul")

// UB if divisor is zero
pub let i64_div : (I64, I64) -> I64 = builtin("%i64_div")

// UB if divisor is zero
pub let i64_rem : (I64, I64) -> I64 = builtin("%i64_rem")

// UB if argument is -2^63
pub let i64_neg : (I64) -> I64 = builtin("%i64_neg")

pub let i64_equal : (I64, I64) -> Bool = builtin("%i64_equal")

pub let i64_less : (I64, I64) -> Bool = builtin("%i64_less")

pub let f64_add : (F64, F64) -> F64 = builtin("%f64_add")

pub let f64_sub : (F64, F64) -> F64 = builtin("%f64_sub")

pub let f64_mul : (F64, F64) -> F64 = builtin("%f64_mul")

pub let f64_div : (F64, F64) -> F64 = builtin("%f64_div")

pub let f64_neg : (F64) -> F64 = builtin("%f64_neg")

pub let f64_equal : (F64, F64) -> Bool = builtin("%f64_equal")

pub let f64_less : (F64, F64) -> Bool = builtin("%f64_less")

pub let f64_inf : F64 = builtin("%f64_inf")

pub let f64_ninf : F64 = builtin("%f64_ninf")

pub let f64_nan : F64 = builtin("%f64_nan")

pub let i64_to_f64 : (I64) -> F64 = builtin("%i64_to_f64")

// UB if the argument is NaN, infinite, or outside the I64 range
pub let f64_to_i64 : (F64) -> I64 = builtin("%f64_to_i64")

pub let f64_to_string : (F64) -> String = builtin("%f64_to_string")

pub let f32_add : (F32, F32) -> F32 = builtin("%f32_add")

pub let f32_sub : (F32, F32) -> F32 = builtin("%f32_sub")

pub let f32_mul : (F32, F32) -> F32 = builtin("%f32_mul")

pub let f32_div : (F32, F32) -> F32 = builtin("%f32_div")

pub let f32_neg : (F32) -> F32 = builtin("%f32_neg")

pub let f32_equal : (F32, F32) -> Bool = builtin("%f32_equal")

pub let f32_less : (F32, F32) -> Bool = builtin("%f32_less")

pub let f32_inf : F32 = builtin("%f32_inf")

pub let f32_ninf : F32 = builtin("%f32_ninf")

pub let f32_nan : F32 = builtin("%f32_nan")

pub let i64_to_f32 : (I64) -> F32 = builtin("%i64_to_f32")

// UB if the argument is NaN, infinite, or outside the I64 range
pub let f32_to_i64 : (F32) -> I64 = builtin("%f32_to_i64")

pub let f32_to_f64 : (F32) -> F64 = builtin("%f32_to_f64")

pub let f64_to_f32 : (F64) -> F32 = builtin("%f64_to_f32")

pub let f32_to_string : (F32) -> String = builtin("%f32_to_string")

// if overflow, return the overflowed value
pub let i32_add : (I32, I32) -> I32 = builtin("%i32_add")

// if overflow, return the overflowed value
pub let i32_sub : (I32, I32) -> I32 = builtin("%i32_sub")

// if overflow, return the overflowed value
pub let i32_mul : (I32, I32) -> I32 = builtin("%i32_mul")

// UB if divisor is zero or the quotient is not representable
pub let i32_div : (I32, I32) -> I32 = builtin("%i32_div")

// UB if divisor is zero
pub let i32_rem : (I32, I32) -> I32 = builtin("%i32_rem")

pub let i32_neg : (I32) -> I32 = builtin("%i32_neg")

pub let i32_equal : (I32, I32) -> Bool = builtin("%i32_equal")

pub let i32_less : (I32, I32) -> Bool = builtin("%i32_less")

pub let i32_to_i64 : (I32) -> I64 = builtin("%i32_to_i64")

pub let i64_to_i32 : (I64) -> I32 = builtin("%i64_to_i32")

pub let char_to_i32 : (Char) -> I32 = builtin("%char_to_i32")

// UB unless the argument is a Unicode scalar value
pub let i32_to_char : (I32) -> Char = builtin("%i32_to_char")

pub let byte_to_i64 : (Byte) -> I64 = builtin("%byte_to_i64")

pub let i64_to_byte : (I64) -> Byte = builtin("%i64_to_byte")

// UB if length < 0
pub let bytes_make : (I64, Byte) -> Bytes = builtin("%bytes_make")

pub let bytes_length : (Bytes) -> I64 = builtin("%bytes_length")

// UB if not (index >= 0 && index < bytes_length)
pub let bytes_get : (Bytes, I64) -> Byte = builtin("%bytes_get")

// UB if not (index >= 0 && index < bytes_length)
pub let bytes_set : (Bytes, I64, Byte) -> Bytes = builtin("%bytes_set")

pub let string_to_bytes : (String) -> Bytes = builtin("%string_to_bytes")

pub let bytes_is_valid_utf8 : (Bytes) -> Bool = builtin("%bytes_is_valid_utf8")

// UB unless the argument contains valid UTF-8
pub let bytes_to_string : (Bytes) -> String = builtin("%bytes_to_string")

pub let bytes_equal : (Bytes, Bytes) -> Bool = builtin("%bytes_equal")

pub let bytes_concat : (Bytes, Bytes) -> Bytes = builtin("%bytes_concat")

// UB unless start and length select an in-bounds byte range
pub let bytes_slice : (Bytes, I64, I64) -> Bytes = builtin("%bytes_slice")
