module Build

import Basic.Prelude.*
import Basic.Build.{ Export, Project, build as build_project }
import Basic.Build.Host.{ run as run_build }

pub fn build() -> Unit ! { Io, Panic } {
  run_build(
    fn() {
      build_project(
        Project::{
          sources: [
            "src/build.lane",
            "src/build/host.lane",
            "src/build/inspection.lane",
            "src/builtins.lane",
            "src/conv/char.lane",
            "src/conv/f32.lane",
            "src/conv/f64.lane",
            "src/conv/i32.lane",
            "src/conv/i64.lane",
            "src/conv/list.lane",
            "src/conv/option.lane",
            "src/conv/unit.lane",
            "src/data/alist.lane",
            "src/data/bool.lane",
            "src/data/byte.lane",
            "src/data/bytes.lane",
            "src/data/char.lane",
            "src/data/f32.lane",
            "src/data/f64.lane",
            "src/data/i32.lane",
            "src/data/i64.lane",
            "src/data/list.lane",
            "src/data/option.lane",
            "src/data/result.lane",
            "src/data/string.lane",
            "src/data/tuple.lane",
            "src/data/unit.lane",
            "src/data/void.lane",
            "src/derive/debug.lane",
            "src/derive/equal.lane",
            "src/derive.lane",
            "src/eff/bound.lane",
            "src/eff/exn.lane",
            "src/eff/loop.lane",
            "src/eff/reader.lane",
            "src/eff/ref.lane",
            "src/eff/state.lane",
            "src/eff/writer.lane",
            "src/io.lane",
            "src/ops.lane",
            "src/platform/wasip1.lane",
            "src/prelude.lane",
            "src/summon.lane",
            "src/system/process.lane",
            "src/system/file_system.lane",
            "src/trait/app.lane",
            "src/trait/bool.lane",
            "src/trait/compare.lane",
            "src/trait/debug.lane",
            "src/trait/derive.lane",
            "src/trait/equal.lane",
            "src/trait/flat.lane",
            "src/trait/iso.lane",
            "src/trait/map.lane",
            "src/trait/monoid.lane",
            "src/trait/num.lane",
            "src/wasm/abi.lane",
            "test/assert.lane",
            "test/assert_summary.lane",
            "test/build/inspection.lane",
            "test/build/project.lane",
            "test/data/alist.lane",
            "test/data/bytes.lane",
            "test/data/char.lane",
            "test/data/f32.lane",
            "test/data/f64.lane",
            "test/data/i32.lane",
            "test/data/i64.lane",
            "test/data/list.lane",
            "test/data/option.lane",
            "test/data/string.lane",
            "test/derive/debug.lane",
            "test/eff/bound.lane",
            "test/eff/exn.lane",
            "test/eff/loop.lane",
            "test/eff/writer.lane",
            "test/eff/state.lane",
            "test/eff/composition.lane",
            "test/entry.lane",
            "test/io.lane",
            "test/failing_entry.lane",
            "test/prelude.lane",
            "test/system/process.lane"
          ],
          exports: [
            Export::{ module_name: "Test.Entry", value_name: "test_entry", wasm_name: "test" }
          ],
          output: "basic.wasm",
          artifact_directory: ".lanebuild"
        }
      )
    }
  )
}
