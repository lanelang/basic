module Build

import Basic.Data.Option.{ Option }
import Basic.Data.Void.{ absurd }
import Basic.Io.{ panic }
import Basic.System.Process.{ Command, CommandResult, run_command }

fn fail(message : String) -> Unit ! { Io, Panic } {
  absurd(panic(message))
}

pub fn test() -> Unit ! { Io, Panic } {
  let result = run_command(
    Command::{
      executable: "lane",
      arguments: ["run", "test/entry.lane:test_entry", "--lib-dir", ".", "--no-basic"],
      working_directory: none(),
      environment: [],
      inherit_environment: true
    }
  )
  match result {
    exited(0i32) => ()
    exited(_) => fail("Basic test command failed")
    signaled(_) => fail("Basic test command was terminated by a signal")
    invalid_request() => fail("Basic test command request was invalid")
    executable_not_found() => fail("the `lane` executable was not found on PATH")
    permission_denied() => fail("the `lane` executable could not be executed")
    system_failure() => fail("the Basic test command could not be started")
  }
}
